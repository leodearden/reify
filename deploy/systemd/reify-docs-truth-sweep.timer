[Unit]
Description=Reify docs-truth sweep timer: weekly check for new docs-truth findings
Documentation=file:///home/leo/src/reify/docs/notes/docs-truth-sweep.md

[Timer]
# Weekly, Monday 06:00; the cadence argument is in docs/notes/docs-truth-sweep.md.
OnCalendar=Mon *-*-* 06:00:00
# Catch up a tick missed while the host was down (applies to OnCalendar= only).
Persistent=true
Unit=reify-docs-truth-sweep.service

[Install]
WantedBy=timers.target
