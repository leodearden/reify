/// Target-surface fixture for docs/prds/v0_6/indexed-sub-instantiation.md task α.
///
/// α (#5481) HAS LANDED: the indexer clause `[i in 0..4]` on the `sub`
/// instantiation arm is grammar, so this file now parses with 0 ERROR nodes.
/// (It previously carried an EXPECTED-TO-FAIL note; that note is obsolete.)
///
/// LOAD-BEARING — this file is `include_str!`'d as the α target surface by two
/// test files, and both assert it parses cleanly:
///   - tree-sitter-reify/tests/indexed_sub_grammar_tests.rs
///     (grammar/CST signal — the CI-enforced one)
///   - crates/reify-syntax/tests/indexed_sub_instantiation_parser_tests.rs
///     (hand-parser/AST-lowering signal)
/// Edit the declarations below only in step with those two tests; a change that
/// stops this file parsing will fail both.
///
/// α is syntax only. Typing the domain as `Range<Int>`, scoping the binder, and
/// deriving the collection count cell are task β's (#5482) — so *semantic*
/// diagnostics on this fixture are still expected until β lands.
module indexed_sub_instantiation_surface

structure def Pulley {
    param od : Length = 36mm
    let body = cylinder(od / 2, 8mm)
}

structure def Rig {
    param r_pitch : Length = 18mm

    sub idlers[i in 0..4] = Pulley(od: 30mm + i * 2mm)
        at transform3(orient_identity(), vec3(i * 50mm, 0mm, 0mm))

    forall i in 0..3 : constraint idlers[i].od < idlers[i + 1].od
}
