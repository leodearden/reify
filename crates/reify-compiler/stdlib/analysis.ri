#no_prelude
// Stdlib: Stress Analysis Traits
// Provides trait definitions for stress analysis results and analysis
// configurations. These traits describe the interface for von Mises stress,
// principal stresses, maximum shear stress, and safety factor computations.

// ── Type aliases ──────────────────────────────────────────────────────────

// Stress: dimensionally identical to Pressure (kg·m⁻¹·s⁻²). Surfaced as a
// distinct user-facing name so call sites read naturally — `param yield : Stress`
// vs `param yield : Pressure`. Both spellings resolve to the same Type::Scalar
// dimension and are interchangeable in dimensional algebra.
pub type Stress = Pressure

// Strain: dimensionless ratio of length over length. Like Stress, an alias on
// the user-visible spelling so `param elongation : Strain` reads naturally and
// future tooling can distinguish "an unnamed dimensionless quantity" from "a
// strain" if it cares to.
pub type Strain = Dimensionless

// ── Analysis result trait ──────────────────────────────────────────────────

// AnalysisResult describes the outputs of a stress analysis.
// von_mises_stress, principal_stress_1/2/3, and max_shear_stress are `Stress`
// (Pa, Pressure alias) — tightened from the dimension-agnostic `Real`
// placeholder by RULING Q7 posture 2 (task #6165, Leo 2026-08-10): the
// producing builtins (von_mises, principal_stresses, max_shear) already
// compile to Scalar<PRESSURE>, so a `Real` param holding that value was a
// hard lie under strict dimension equality — not a wildcard — and the same
// stress value typed Scalar<PRESSURE> when read via `von_mises(stress)`
// directly but `Real` when read via a conforming structure's AnalysisResult
// member. Zero conformers of this trait exist repo-wide, so the migration
// was free (re-measured at implementation time). safety_factor_value stays
// `Real`: it is genuinely dimensionless.
// Bare `0` coerced to Scalar<Pressure> by task-4485/β (esc-3115-112 resolved);
// same convention as structural_physical.ri's Plastic/Sealed — do not spell `0Pa`.
// Not a signature source: registry α seeds the analysis builtins from its own
// rows, never from a type read off this trait.
// Posture-3 breadcrumb (ruled as the future upgrade path, not built now): a
// second analysis domain (thermal, modal, buckling) wanting a shared result
// contract should NOT re-weaken these fields to Real — use per-domain sibling
// traits (e.g. ThermalAnalysisResult) or a quantity-parameterized trait; the
// latter's typed-trait-param machinery may already exist (see
// harness_traits/trait_typed_param_tests.rs's dimensioned-param conformance
// coverage) but verify that if/when posture 3 is taken up.
trait AnalysisResult {
    param von_mises_stress : Stress
    param principal_stress_1 : Stress
    param principal_stress_2 : Stress
    param principal_stress_3 : Stress
    param max_shear_stress : Stress
    param safety_factor_value : Real
    constraint von_mises_stress >= 0
    constraint max_shear_stress >= 0
    constraint safety_factor_value > 0
}

// ── Analysis configuration trait ───────────────────────────────────────────

// Analysis describes a stress analysis configuration.
// yield_strength: material yield strength used for safety factor (Pa, using Real).
// Deliberately NOT retyped by RULING Q7 posture 2 (task #6165): this trait
// belongs to decision 9 / task 5807, not this ruling, so yield_strength's
// Real-vs-Stress question is left for that task rather than resolved here by
// symmetry with AnalysisResult's five stress params.
trait Analysis {
    param yield_strength : Real
    constraint yield_strength > 0
}
