#no_prelude
// Stdlib: Unit Declarations
// Provides standard engineering unit definitions for the Reify language.
// All units marked pub so they are visible to downstream modules.
//
// SI prefixed base units (km/mm/nm/…, kg-prefixed grams, ks/ns/…) and all
// standard SI derived units (N/Pa/J/W/Hz/…) are generated programmatically
// by `crates/reify-compiler/src/si_units.rs` and compiled as a synthetic
// `std.si_units` prelude module. This file contains only the SI base units
// themselves and non-SI units (imperial, minute/hour, affine temperatures).

// ── Length (SI base: meter) ─────────────────────────────────────────────────

pub unit m    : Length
pub unit cm   : Length = 0.01
pub unit in   : Length = 0.0254
pub unit ft   : Length = 0.3048
pub unit thou : Length = 0.0000254
pub unit yd   : Length = 0.9144

// ── Angle (SI base: radian) ─────────────────────────────────────────────────

pub unit rad : Angle
pub unit deg : Angle = 3.141592653589793 / 180

// ── Mass (SI base: kilogram) ────────────────────────────────────────────────

pub unit kg  : Mass
pub unit g   : Mass = 0.001
pub unit lb  : Mass = 0.45359237
pub unit oz  : Mass = 0.028349523125

// ── Time (SI base: second) ──────────────────────────────────────────────────

pub unit s   : Time
pub unit min : Time = 60
pub unit h   : Time = 3600

// ── Temperature (SI base: kelvin) ───────────────────────────────────────────

pub unit K    : Temperature
pub unit degC : Temperature = 1 offset 273.15
pub unit degF : Temperature = 5 / 9 offset 255.3722222222222

// ── Force (SI base: newton) ─────────────────────────────────────────────────
// SI newton and its prefixes (kN/MN/…) are generated by si_units.rs.

pub unit lbf  : Force = 4.4482216152605

// ── Pressure (SI base: pascal) ──────────────────────────────────────────────
// SI pascal and its prefixes (kPa/MPa/GPa/…) are generated by si_units.rs.

pub unit psi  : Pressure = 6894.757293168361
pub unit ksi  : Pressure = 6894757.293168361

// ── Torque (SI: newton-metre per radian) ────────────────────────────────────
// Torque = Force·Length/Angle (N·m/rad), distinct from Energy (J = N·m) by the
// Angle⁻¹ slot. `Nm` is NOT generated by si_units.rs — that generator only
// concatenates <prefix><name>, and N's prefix set is Only(["k","M","G"]) — so it
// is hand-declared here. Case-distinct from the generated `nm` (nanometre);
// lookup is an exact HashMap match with no case folding.

pub unit Nm : Torque = 1

// ── Volume (SI base: cubic meter, US customary) ──────────────────────────────
// si_units.rs generates no volume units at all — it only concatenates
// <prefix><name>, and there is no cubic-metre base entry — so the litre is
// hand-declared here, exactly as `Nm` is above.  `L` is a rung of the curated
// Volume display ladder (reify_core::display_units, si_scale 1e-3), so before it
// existed here the display surface advertised a unit the compiler could not
// resolve.  1 L = 0.001 m³ is a definition, so the factor is exact.
//
// Extending si_units.rs with a cubic-metre base entry instead is the path
// decision D7 (docs/prds/v0_6/angle-units-surface-convergence.md) explicitly
// DECLINED: it would trip the exact-count assert over SI_DERIVED_UNITS in
// `si_derived_units_table_defines_newtons_pascals_joules`
// (crates/reify-compiler/tests/si_units_tests.rs — named by symbol, not line,
// so the reference cannot rot) and reopen the
// prefix-ambiguity questions D7 set aside.  Hand-declaring touches
// SI_DERIVED_UNITS not at all.  `mL` and the other SI volume prefixes are
// deliberately NOT declared — D7 scoped this to the single `L` rung the ladder
// names, and a unit no surface displays would be dead weight.
//
// US customary is the project default for imperial volume units.  UK Imperial
// values differ significantly (fl_oz_uk ≈ 2.841e-5 m³, gal_uk ≈ 4.546e-3 m³,
// ~4 % larger than US).  If UK Imperial variants are needed, add them here with
// a `_uk` suffix, e.g. `pub unit fl_oz_uk : Volume = 0.0000284130625`.

pub unit L     : Volume = 0.001
pub unit fl_oz : Volume = 0.0000295735295625
pub unit gal   : Volume = 0.003785411784

// ── Money (no SI base) ──────────────────────────────────────────────────────
// USD is the project-default monetary unit (factor = 1.0, no offset).
// User-defined currencies like `unit GBP : Money = 1.25USD` belong in user
// code, not stdlib — exchange rates are project-scoped and out of scope for
// the standard library. See docs/reify-language-spec.md §4.6.

pub unit USD : Money

// ── Physical Constants ──────────────────────────────────────────────────────
// Dimensionful physical constants. Exposed as zero-arg `pub fn` because Reify
// lacks top-level `const` (see the `standard_stock.ri` module header note);
// migrate when added.
//
// Helper type aliases: the grammar's `type_expr` rule (used for function
// return types) admits `identifier | parameterized_type` only — binary
// dimensional-op expressions (`Length / Time`, `Energy / Temperature`) are
// reserved for `type_alias_declaration` RHS via the `dimensional_type_expr`
// rule. To give these constants accurate `Scalar<dim>` return types, we
// introduce the aliases below; user code may reference them too. esc-4026-121.

/// Velocity dimension, m/s. Originally introduced so `Velocity` could appear in
/// function return type position (where the grammar admits `identifier` only).
/// As of task 4580, `Velocity` IS registered in `NAMED_DIMENSIONS` (m·s⁻¹,
/// adjacent to Acceleration) and the builtin shadows this alias at every
/// use-site (resolution checks builtins before the alias registry). This alias
/// is now effectively dead — kept only as a harmless back-compat alias for any
/// external code that may reference it. Removing it is safe; deferred to a
/// dedicated cleanup pass. TODO(cleanup): remove this alias once the stdlib // ptodo:allow type-placeholder awaiting future type-system PRD
/// alias surface is audited for external dependents.
pub type Velocity = Length / Time

/// Parametric rate-of-change alias: `Rate<Q>` is the dimension `Q` per unit Time.
///
/// This is the DRY generalization of concrete dimensional aliases — e.g.
/// `Velocity = Rate<Length>`, `Acceleration = Rate<Velocity>` — and is the
/// load-bearing proof of the dimensional-op-over-param path (task 4792 PRD D1):
/// the raw TypeExpr body (`Q / Time`) is carried across the CompiledModule
/// boundary and substituted at use-site to produce exact integer-exponent
/// DimensionVector arithmetic (e.g. Rate<Length> → LENGTH/TIME = VELOCITY).
pub type Rate<Q: Dimension> = Q / Time

/// Energy per unit temperature — dimension of entropy / heat capacity /
/// Boltzmann constant. Local alias because no J/K named dimension exists.
pub type HeatCapacity = Energy / Temperature

/// Inverse amount of substance — dimension of Avogadro constant (mol⁻¹).
/// Written as `Dimensionless / AmountOfSubstance` because `Real` is a scalar
/// type, not a dimension identifier; `Dimensionless` is the special-cased zero
/// dimension vector resolved by the compiler.
pub type InverseAmount = Dimensionless / AmountOfSubstance

/// Action dimension (J·s = kg·m²·s⁻¹) — dimension of the Planck constant.
/// Named "Action" after the physical quantity (integral of energy over time).
pub type Action = Energy * Time

/// Stefan-Boltzmann dimension (W·m⁻²·K⁻⁴ = kg·s⁻³·K⁻⁴) — dimension of the
/// Stefan-Boltzmann constant. No standard quantity name exists for this
/// dimension; the alias name is descriptive. T⁴ is written as four repeated
/// `/ Temperature` factors because the grammar forbids `^` and parens in
/// type-alias RHS (PRD §3.6).
pub type StefanBoltzmannDim = Power / Area / Temperature / Temperature / Temperature / Temperature

/// Permittivity dimension (F/m = kg⁻¹·m⁻³·s⁴·A²) — dimension of the vacuum
/// electric permittivity. Equals Capacitance per unit length.
pub type Permittivity = Capacitance / Length

/// Permeability dimension (H/m = kg·m·s⁻²·A⁻²) — dimension of the vacuum
/// magnetic permeability. Equals Inductance per unit length.
pub type Permeability = Inductance / Length

/// Molar gas constant dimension (J·mol⁻¹·K⁻¹ = kg·m²·s⁻²·mol⁻¹·K⁻¹) —
/// dimension of the molar gas constant R = N_A·k_B.
pub type MolarGasConstant = Energy / AmountOfSubstance / Temperature

/// Pressure squared (Pa² = kg²·m⁻²·s⁻⁴). No standard named quantity exists for
/// this dimension, so the alias name is positional: the digit IS the exponent.
///
/// Exists so `std.fea`'s `StressInvariants.i2` can declare the dimension the
/// `stress_invariants` builtin ALREADY emits — the runtime computes
/// `let dim2 = dim.mul(&dim)` (crates/reify-stdlib/src/analysis.rs) — replacing
/// the `Real` placeholder that was previously used only because no such alias
/// existed. Task #6092.
pub type Pressure2 = Pressure * Pressure

/// Pressure cubed (Pa³ = kg³·m⁻³·s⁻⁶) — dimension of the third stress invariant
/// I3 = det(σ), which the `stress_invariants` builtin emits as
/// `dim2.mul(&dim)`. Alias name is positional, as for `Pressure2`. Task #6092.
///
/// Chained through `Pressure2` rather than spelled `Pressure * Pressure *
/// Pressure` because the grammar forbids `^` and parens in type-alias RHS (the
/// same constraint documented on `StefanBoltzmannDim` above, which writes T⁴ as
/// four repeated factors). Chaining is also DRY — one place defines the square —
/// and the transitive-alias path resolves to exactly PRESSURE³, identical to
/// `PRESSURE.mul(&PRESSURE).mul(&PRESSURE)`, with no precision loss.
pub type Pressure3 = Pressure2 * Pressure

/// Standard acceleration of gravity (g_n), 9.80665 m/s² — BIPM/CGPM 1901 §70
/// reference value. Use in body-force loads: `gravity(5 * STANDARD_GRAVITY())`.
/// Body uses the compositional `1m / (1s * 1s)` form rather than the compound
/// literal `9.80665m/s^2`: compound-unit resolution requires the unit registry
/// in scope, but std.units bootstraps that registry, so its own function
/// bodies compile in the registry-less scope guarded in expr.rs (same
/// constraint documented for BOLTZMANN_CONSTANT below). SI value is identical.
pub fn STANDARD_GRAVITY() -> Acceleration { 9.80665 * 1m / (1s * 1s) }

/// Speed of light in vacuum (c), 299792458 m/s exactly — SI definition
/// (BIPM, 1983 redefinition of the metre via the second). Use in EM and
/// relativistic computations: `let kinetic = 0.5 * m * (v * v) / SPEED_OF_LIGHT()`.
pub fn SPEED_OF_LIGHT() -> Velocity { 299792458.0 * 1m / 1s }

/// Boltzmann constant (k_B), 1.380649×10⁻²³ J/K — exact by the 2019 SI
/// redefinition (26th CGPM, Resolution 1). Used in thermal-energy expressions:
/// `let thermal_energy = BOLTZMANN_CONSTANT() * 300K`.
/// Body uses `1m * 1m * 1kg / (1s * 1s * 1K)` because `J` is generated in
/// std.si_units, which compiles AFTER std.units; the resulting SI value is
/// identical (J = kg·m²·s⁻²).
pub fn BOLTZMANN_CONSTANT() -> HeatCapacity {
    1.380649e-23 * 1kg * 1m * 1m / (1s * 1s * 1K)
}

/// Avogadro constant (N_A), 6.02214076×10²³ mol⁻¹ — exact by the 2019 SI
/// redefinition (26th CGPM, Resolution 1). Body: `coefficient * 1mol / 1mol / 1mol`
/// anchors a mol in the numerator so the expression is Scalar-valued from the
/// first `*` (eval_div requires Scalar in the numerator; Real / Scalar is
/// unhandled). Net dimension: mol¹ / mol¹ / mol¹ = mol⁻¹ = InverseAmount.
pub fn AVOGADRO_CONSTANT() -> InverseAmount { 6.02214076e23 * 1mol / 1mol / 1mol }

/// Planck constant (h), 6.62607015×10⁻³⁴ J·s — exact by the 2019 SI
/// redefinition (26th CGPM, Resolution 1). Dimension: Action = kg·m²·s⁻¹.
/// Body uses base units (J = kg·m²·s⁻² from std.si_units, unavailable here).
pub fn PLANCK_CONSTANT() -> Action { 6.62607015e-34 * 1kg * 1m * 1m / 1s }

/// Stefan-Boltzmann constant (σ), 5.670374419×10⁻⁸ W·m⁻²·K⁻⁴ — CODATA 2018.
/// Relates radiated power density to T⁴: P/A = σ·T⁴. Dimension: kg·s⁻³·K⁻⁴.
/// Body uses base units; W and m² from std.si_units are unavailable here.
pub fn STEFAN_BOLTZMANN_CONSTANT() -> StefanBoltzmannDim {
    5.670374419e-8 * 1kg / 1s / 1s / 1s / 1K / 1K / 1K / 1K
}

/// Vacuum electric permittivity (ε₀), 8.8541878128×10⁻¹² F/m — CODATA 2018.
/// Fundamental constant in electrostatics: F = ε₀·E²/2. Dimension: kg⁻¹·m⁻³·s⁴·A².
/// Body uses base units; F from std.si_units is unavailable here. Requires
/// dependency α bare `1A` arm in unit_to_scalar.
pub fn VACUUM_PERMITTIVITY() -> Permittivity {
    8.8541878128e-12 * 1s * 1s * 1s * 1s * 1A * 1A / 1kg / 1m / 1m / 1m
}

/// Vacuum magnetic permeability (μ₀), 1.25663706212×10⁻⁶ H/m — CODATA 2018.
/// Fundamental constant in magnetostatics: B = μ₀·H. Dimension: kg·m·s⁻²·A⁻².
/// Body uses base units; H from std.si_units is unavailable here. Requires
/// dependency α bare `1A` arm in unit_to_scalar.
pub fn VACUUM_PERMEABILITY() -> Permeability {
    1.25663706212e-6 * 1kg * 1m / 1s / 1s / 1A / 1A
}

/// Molar gas constant (R), 8.314462618 J·mol⁻¹·K⁻¹ — exact by the 2019 SI
/// redefinition (R = N_A·k_B; 26th CGPM, Resolution 1). Used in ideal-gas
/// computations: `let pV = MOLAR_GAS_CONSTANT() * n * T`. Dimension: kg·m²·s⁻²·mol⁻¹·K⁻¹.
/// Body uses base units; J from std.si_units is unavailable here. Requires
/// dependency α bare `1mol` arm in unit_to_scalar.
pub fn MOLAR_GAS_CONSTANT() -> MolarGasConstant {
    8.314462618 * 1kg * 1m * 1m / 1s / 1s / 1mol / 1K
}

/// Elementary charge (e), 1.602176634×10⁻¹⁹ C — exact by the 2019 SI
/// redefinition (26th CGPM, Resolution 1). This equals the eV factor in
/// si_units.rs. Uses the pre-existing `Charge` named dimension (no new alias).
/// Dimension: s·A. Requires dependency α bare `1A` arm in unit_to_scalar.
pub fn ELEMENTARY_CHARGE() -> Charge { 1.602176634e-19 * 1A * 1s }
