// Executable transcription of the "Key Geometry Operations" (+ "Curves") table
// in crates/reify-mcp/src/tools/chunks/stdlib.md (topic="stdlib"), concretized
// over real primitives/profiles so it can be fed to compile_with_stdlib.
//
// SYNC CONTRACT: every call form below mirrors a signature documented in that
// chunk's "Key Geometry Operations" / "Curves" section. The companion test
// crates/reify-compiler/tests/harness_doc_chunks/stdlib_chunk_geometry_ops_smoke.rs
// (run via `cargo test -p reify-compiler --test harness_doc_chunks`) asserts
// FOUR things, none of which alone is sufficient:
//   1. this file compiles with ZERO Error-severity diagnostics — every
//      documented form is accepted AT THE ARITY WRITTEN, FOR THE NAMES THE
//      COMPILER RESOLVES;
//   2. every call name below is a real entry in the compiler's own geometry-op /
//      topology-selector registries — because an unknown call name in a
//      `structure def` body is silently ignored (no diagnostic at ANY severity),
//      so a documented-but-nonexistent op would pass (1) untouched;
//   3. every name documented in the chunk is real AND appears below — the
//      doc→fixture direction, at NAME granularity; and
//   4. every documented (name, arity) FORM — with `…` read as variadic — has a
//      call below at that exact arity: the doc→fixture direction, at FORM
//      granularity (a second overload of an already-documented name must be
//      mirrored too, not just the name; task 5583).
// NOT enforced, and therefore review-time responsibilities:
//   - argument DIMENSION/TYPE. Only arity is checked for these ops (no Key
//     Geometry Operation has a checkable slot in builtin_signatures.rs), so
//     `extrude(prof, 5)` would compile just as green. The unit convention used
//     below — positions/lengths in `mm`, angles in `deg`, direction/axis/normal
//     components and counts as plain numbers — mirrors the chunk's prose line
//     but nothing verifies it;
//   - argument ORDER.
// Keep the two files in lockstep: if you edit a signature in one, edit it in the
// other. Renaming a call here to something with no compiler arm goes RED.
//
// Each form is the exact arity/overload the compiler accepts (verified against
// the match arms in reify-compiler/src/geometry{,_transform,_boolean,_modify,
// _curve}.rs). Where an ergonomic value-form overload exists (mirror/plane,
// circular_pattern/axis, rotate/orientation) it is exercised alongside the
// all-scalar form.

structure def StdlibGeometryOpsSmoke {
    // ── Inputs (real constructors) ──────────────────────────────────────────
    let a     = box(20mm, 20mm, 20mm)
    let b     = box(10mm, 10mm, 30mm)
    let solid = box(30mm, 20mm, 10mm)
    let prof  = rectangle(20mm, 10mm)
    let prof2 = circle(8mm)
    let path  = line_segment(0mm, 0mm, 0mm, 0mm, 0mm, 40mm)
    let curve = line_segment(0mm, 0mm, 0mm, 20mm, 0mm, 0mm)
    let guide = line_segment(5mm, 0mm, 0mm, 5mm, 0mm, 40mm)

    // ── Booleans: union/difference/intersection(a, b) [2]; *_all variadic ───
    let u  = union(a, b)
    let d  = difference(a, b)
    let i  = intersection(a, b)
    let ua = union_all(a, b, solid)
    let ia = intersection_all(a, b, solid)

    // ── Modify ──────────────────────────────────────────────────────────────
    let fil2 = fillet(solid, 1mm)                  // fillet(solid, radius)          [2, all edges]
    let fil3 = fillet(solid, edges(solid), 1mm)    // fillet(solid, edges, radius)   [3, curated]
    let cha2 = chamfer(solid, 1mm)                 // chamfer(solid, distance)       [2, all edges]
    let cha3 = chamfer(solid, edges(solid), 1mm)   // chamfer(solid, edges, distance)[3, curated]
    let sh1  = shell(solid, 1mm)                   // shell(solid, thickness)        [all faces]
    let sh2  = shell(solid, 1mm, 0)                // shell(solid, thickness, face…) [remove face 0]
    let ofs  = offset_solid(solid, 1mm)            // offset_solid(solid, distance)
    let ofsu = offset_surface(prof, 1mm)           // offset_surface(surface, distance) [prof is a planar face]
    let thk  = thicken(solid, 1mm)                 // thicken(solid, offset)
    let ofc  = offset_curve(curve, 1mm)            // offset_curve(curve, distance)
    let fila = fillet_all(solid, 1mm)              // fillet_all(solid, radius)
    let chas = chamfer_asymmetric(solid, edges(solid), 1mm, 2mm)  // chamfer_asymmetric(solid, edges, d1, d2) [edges mandatory]
    let sho  = shell_open(solid, 1mm, faces(solid))              // shell_open(solid, thickness, faces)
    let dr3  = draft(solid, 5deg, plane_xy(0mm))                 // draft(solid, angle, plane)        [3, all faces]
    let dr4  = draft(solid, faces(solid), 5deg, plane_xy(0mm))   // draft(solid, faces, angle, plane) [4, curated]

    // ── Sweep ────────────────────────────────────────────────────────────────
    let ex = extrude(prof, 5mm)                                  // extrude(profile, distance)
    let rv = revolve(prof, 0mm, 0mm, 0mm, 0, 1, 0, 360deg)      // revolve(profile, ox,oy,oz, ax,ay,az, angle)
    let sw = sweep(prof2, path)                                  // sweep(profile, path)
    let lf = loft(prof, prof2)                                   // loft(profile1, profile2, …)
    let exs = extrude_symmetric(prof, 10mm)                      // extrude_symmetric(profile, total_distance) [total extent]
    let exi = extrude_infinite(prof, 0, 0, 1, "positive")        // extrude_infinite(profile, dx,dy,dz, direction) [unbounded]
    let rvf = revolve_full(prof, 0mm, 0mm, 0mm, 0, 1, 0)        // revolve_full(profile, ox,oy,oz, ax,ay,az) [no angle]
    let swg = sweep_guided(prof2, path, guide)                   // sweep_guided(profile, path, guide)
    let pip = pipe(path, 2mm)                                    // pipe(path, radius) [path FIRST, no profile arg]
    let lfg = loft_guided(prof, prof2, guide)                    // loft_guided(profile1, profile2, …, guide) [guide TRAILING]

    // ── Transform ─────────────────────────────────────────────────────────────
    let tr  = translate(solid, 1mm, 2mm, 3mm)      // translate(geo, dx, dy, dz)
    let ro5 = rotate(solid, 0, 0, 1, 90deg)        // rotate(geo, ax, ay, az, angle)  [5, scalar]
    let ro2 = rotate(solid, orient_identity())     // rotate(geo, orientation)        [2, value]
    let mi2 = mirror(solid, plane_xy(0mm))         // mirror(geo, plane)              [2, value]
    let mi7 = mirror(solid, 0mm, 0mm, 0mm, 1, 0, 0)  // mirror(geo, ox,oy,oz, nx,ny,nz) [7, scalar]
    let sc  = scale(solid, 2.0)                    // scale(geo, factor)
    let rar = rotate_around(solid, 0mm, 0mm, 0mm, 0, 0, 1, 90deg)  // rotate_around(geo, px,py,pz, ax,ay,az, angle)
    let apt = apply_transform(solid, transform3_identity())         // apply_transform(geo, transform)  [rigid]
    let afa = affine_apply(solid, affine_scale(1.0, 1.0, 1.5))      // affine_apply(geo, map)           [general affine]

    // ── Pattern ───────────────────────────────────────────────────────────────
    let lp  = linear_pattern(solid, 1, 0, 0, 3, 5mm)                   // linear_pattern(geo, dx,dy,dz, count, spacing)
    let lp2 = linear_pattern_2d(solid, 1, 0, 0, 3, 20mm, 0, 1, 0, 3, 20mm)  // linear_pattern_2d(geo, dir1, count1, spacing1, dir2, count2, spacing2)
    let apr = arbitrary_pattern(solid, 10mm, 0mm, 0mm, 0mm, 20mm, 0mm)      // arbitrary_pattern(geo, dx1,dy1,dz1, …) [offset triples]
    let apl = arbitrary_pattern(solid, [transform3_identity()])             // arbitrary_pattern(geo, transforms)     [2, List<Transform<3>>]
    let cp4 = circular_pattern(solid, axis_z(point3(0mm, 0mm, 0mm)), 6, 360deg)   // (geo, axis, count, angle) [4, value]
    let cp9 = circular_pattern(solid, 0mm, 0mm, 0mm, 0, 0, 1, 6, 360deg)          // (geo, ox,oy,oz, ax,ay,az, count, angle) [9]
    let spl = split(solid, plane_xy(0mm))          // split(solid, plane) → List<Geometry> (topology selector)

    // ── Curves ────────────────────────────────────────────────────────────────
    let ls = line_segment(0mm, 0mm, 0mm, 10mm, 0mm, 0mm)                 // line_segment(x1,y1,z1, x2,y2,z2)
    let ar = arc(0mm, 0mm, 0mm, 5mm, 0deg, 90deg, 0, 0, 1)              // arc(cx,cy,cz, radius, start,end, ax,ay,az)
    let hx = helix(5mm, 2mm, 20mm)                                       // helix(radius, pitch, height)
    let ip = interp(0mm, 0mm, 0mm, 5mm, 5mm, 0mm, 10mm, 0mm, 0mm)       // interp(x1,y1,z1, …) coord triples
    let bz = bezier(0mm, 0mm, 0mm, 5mm, 10mm, 0mm, 10mm, 0mm, 0mm)      // bezier(x1,y1,z1, …) coord triples
    let nb = nurbs(1, 2, 0mm, 0mm, 0mm, 10mm, 0mm, 0mm, 1.0, 1.0)       // nurbs(degree, n_pts, coords…, weights…)
}
