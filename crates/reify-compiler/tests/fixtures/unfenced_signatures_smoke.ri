// Executable mirror of the signatures written in the unfenced prose of
// crates/reify-mcp/src/tools/chunks/*.md — one call per documented (name, arity)
// form that stdlib_geometry_ops_smoke.ri does not already exercise, over
// type-plausible arguments.
//
// SYNC CONTRACT: every signature-shaped span in those chunks' unfenced prose is
// mirrored here or in stdlib_geometry_ops_smoke.ri at its documented arity —
// guarded by crates/reify-compiler/tests/harness_doc_chunks/unfenced_signature_gate.rs
// — and this file compiles clean — guarded by
// crates/reify-compiler/tests/harness_doc_chunks/signature_fixtures.rs.
// Which of these calls the compiler truly arity-checks, and which it passes
// silently, is stated in the first gate's module doc.

structure def OptionAndCollectionForms {
    let coating = some(1mm)
    let bare    = unwrap_or(coating, 0mm)
    let dflt    = or_default(coating, 0mm)
    let fb      = fallback(coating, 0mm)
    let alt     = or_else(coating, some(2mm))
    let has     = is_some(coating)
    let lacks   = is_none(coating)
    let res     = ok_or(coating, "no coating")
    let evens   = generate(3, |i: Int| i * 2)
}

structure def FieldForms {
    let doubled  = fn_field(|p: Length| p * 2.0)
    let uniform  = constant_field(1mm)
    let sampled  = from_samples([0mm, 1mm], [0mm, 2mm], InterpolationMethod.Linear)
    let composed = compose(doubled, uniform)
    let at_one   = sample(doubled, 1mm)
    let clipped  = restrict(doubled, 0mm..1mm)
}

structure def GeometryQueryForms {
    let s      = sphere(5mm)
    let plate  = box(60mm, 40mm, 8mm)
    let other  = translate(box(20mm, 20mm, 20mm), 80mm, 0mm, 0mm)
    let prof   = rectangle(40mm, 20mm)
    let rim    = line_segment(0mm, 0mm, 0mm, 20mm, 0mm, 0mm)
    let origin = point3(0mm, 0mm, 0mm)
    let up     = vec3(0.0, 0.0, 1.0)
    let across = vec3(1.0, 0.0, 0.0)
    let tol    = 0.001mm
    let top    = single(faces(plate))

    let iso2   = isosurface(s, 3mm)
    let iso3   = isosurface(s, iso: 3mm, adaptive: true)
    let fouls  = intersects(plate, other)
    let gap    = distance(plate, other)
    let v      = volume(plate)
    let a      = area(prof)
    let l      = length(rim)
    let per    = perimeter(prof)
    let c      = centroid(plate)
    let bb     = bounding_box(plate)
    let inside = contains(plate, origin)
    let same   = geo_equiv(plate, plate, tol)
    let n      = normal(top, origin)
    let k      = curvature(rim, origin)
    let theta  = angle(up, across)
    let dev    = max_deviation(plate, other)
    let feat   = feature(plate)
}

structure def MechanismForms {
    let part_a = cylinder_centered(10mm, 40mm)
    let part_b = translate(box(20mm, 20mm, 20mm), 30mm, 0mm, 0mm)

    let m0   = mechanism()
    let m1   = body(m0, "part_a", fixed())
    let m2   = body(m1, "part_b", fixed())
    let id_a = body_id_of(m2, "part_a")
    let id_b = body_id_of(m2, "part_b")
    let s    = snapshot(m2, [])

    let clr   = min_clearance(s, id_a, id_b)
    let fouls = interferes_with(s, id_a, id_b)
    let pairs = interferes(s)
}

structure def TopologySelectorForms {
    let b       = box(10mm, 10mm, 10mm)
    let up      = vec3(0.0, 0.0, 1.0)
    let across  = vec3(1.0, 0.0, 0.0)
    let tol     = 1deg
    let etol    = 0.001mm
    let plane   = "Plane"
    let line    = "Line"
    let ax      = "Z"
    let sense   = "Max"
    let density = 7800kg/m^3
    let p       = point3(5mm, 0mm, 0mm)
    let feat    = feature(b)
    let top     = single(faces_by_normal(b, up, tol))
    let right   = single(faces_by_normal(b, across, tol))
    let an_edge = single(edges(b))

    let corners    = vertices(b)
    let mids       = mid_surface(b)
    let named_face = face(b, "x_max")
    let named_edge = edge(b, "rim")
    let named_vtx  = vertex(b, "corner")
    let named_body = solid_body(b, "core")
    let big        = faces_by_area(b, 0mm^2 .. 1m^2)
    let long_edges = edges_by_length(b, 0mm..50mm)
    let facing_up  = faces_by_normal(b, up, tol)
    let vertical   = edges_parallel_to(b, up, tol)
    let at_top     = edges_at_height(b, 10mm, etol)
    let perp_faces = faces_perpendicular_to(b, up, tol)
    let perp_edges = edges_perpendicular_to(b, up, tol)
    let planar     = faces_by_surface_kind(b, plane)
    let straight   = edges_by_curve_kind(b, line)
    let top_bbox   = extremal_by_bbox(b, ax, sense, etol)
    let top_cent   = extremal_by_centroid(b, ax, sense, etol)
    let made       = created_by_feature(b, feat)
    let split_off  = split_by_feature(b, feat)
    let neighbours = adjacent_faces(b, top)
    let shared     = shared_edges(top, right)
    let siblings   = siblings_of_face(b, top)
    let owners     = ancestor_faces_of_edge(b, an_edge)
    let nearest    = closest_point(p, b)
    let lies_on    = is_on(p, b)
    let between    = angle_between_surfaces(top, right)
    let com        = center_of_mass(b, density)
    let moi        = moment_of_inertia(b, density)
}
