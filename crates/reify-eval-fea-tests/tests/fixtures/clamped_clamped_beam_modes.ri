// Modal BC-kind fixture: two FixedSupports must mean CLAMPED-CLAMPED, and two
// PinnedSupports must mean PINNED-PINNED — on ONE section, in ONE eval, so the
// two realizations can be compared directly (task 6663).
//
// Why this fixture exists (the defect it pins):
//   `modal_ops::build_dirichlet_bcs` used to discriminate its BC realization on
//   the support TARGET FACE NAMES ONLY and never read the support KIND, so
//   `[FixedSupport("x_min"), FixedSupport("x_max")]` and
//   `[PinnedSupport("x_min"), PinnedSupport("x_max")]` produced a BIT-IDENTICAL
//   Dirichlet set — both the pinned-pinned one. Measured in the dogfood round:
//   both returned 391.049 Hz, against the clamped-clamped analytic 900.7 Hz.
//
// Section (the dogfood gantry tube): L = 800 mm, square 44.588 × 44.588 mm,
// E = 110 GPa, ν = 0.3, ρ = 695.39 kg/m³ (a CFRP rolled tube smeared to a solid
// section of equivalent EI and mass/length).
//
// Analytic Euler–Bernoulli fundamentals, fₙ = (βL)²/(2π) · √(E·I / (ρ·A·L⁴)):
//   pinned-pinned  βL = π        → f₁ ≈ 397.33 Hz
//   clamped-clamped βL = 4.730041 → f₁ ≈ 900.70 Hz     (ratio 2.267)
//
// AUTHORING TRAP — `ModalOptions` argument binding is POSITIONAL: the `name:`
// labels are cosmetic and the parser binds by DECLARATION order (n_modes,
// boundary_conditions, damping, sigma, tol, max_iters, reference_direction,
// element_order). `element_order` is LAST, so every preceding param must be
// spelled out or `ElementOrder.P2` lands in an earlier slot and the P1 bending
// lock never lifts. Likewise `modal_analysis` declares
// `material : ElasticMaterial`, so the material is wrapped as
// `FEAMaterialInput(material: mat)` and passed as `mi.material`.

structure def CFRP_Rolled_Tube : ElasticMaterial + Visual {
    param youngs_modulus : Pressure = 110GPa
    param poisson_ratio : Real = 0.3
    param density : Density = 695.39kg/m^3
    param yield_stress : Option<Pressure> = some(600MPa)
    param appearance : Appearance = Appearance(
        color: Color(r: 0.15, g: 0.15, b: 0.17),
        finish: Finish.Satin,
        metalness: 0.1,
        roughness: 0.6
    )
}

structure ClampedClampedBeamModes {
    // Geometry: 800 mm span, square 44.588 mm section (width == height).
    param span : Length = 800mm
    let h = 44.588mm
    let h2 = h * 1.0

    let material = CFRP_Rolled_Tube()

    // Wrap in FEAMaterialInput so member-access `.material` has compile-time
    // type ElasticMaterial (matching the fn param type).
    let mi = FEAMaterialInput(material: material)

    // The two support KINDS under test, on the SAME two end faces.
    let fix_min = FixedSupport(target: "x_min")
    let fix_max = FixedSupport(target: "x_max")
    let pin_min = PinnedSupport(target: "x_min")
    let pin_max = PinnedSupport(target: "x_max")

    // Two otherwise-identical ModalOptions differing ONLY in support kind.
    let opts_fixed = ModalOptions(
        n_modes: 2,
        boundary_conditions: [fix_min, fix_max],
        damping: NoDamping(),
        sigma: 0.0,
        tol: 0.000000001,
        max_iters: 200,
        reference_direction: vec3(0.0, 0.0, 1.0),
        element_order: ElementOrder.P2
    )
    let opts_pinned = ModalOptions(
        n_modes: 2,
        boundary_conditions: [pin_min, pin_max],
        damping: NoDamping(),
        sigma: 0.0,
        tol: 0.000000001,
        max_iters: 200,
        reference_direction: vec3(0.0, 0.0, 1.0),
        element_order: ElementOrder.P2
    )

    // Distinct length cells per call, mirroring the validated dogfood probe
    // spelling (/home/leo/.claude/fleet/sessions/dogfood-reify-1519747/probes/
    // modal_bc_probe.ri) so the two @optimized calls stay distinct ComputeNodes.
    let span_f = span * 1.0
    let span_p = span * 1.0

    let result_fixed  = modal_analysis(mi.material, span_f, h, h2, opts_fixed)
    let result_pinned = modal_analysis(mi.material, span_p, h, h2, opts_pinned)

    let f1_fixed  = first_frequency(result_fixed)
    let f1_pinned = first_frequency(result_pinned)
}
