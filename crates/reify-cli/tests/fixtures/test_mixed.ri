// CLI test fixture: three @test structures with mixed outcomes.
//   TestPass     — satisfied constraint      (PASS)
//   TestFail     — violated constraint       (FAIL)
//   TestIndet    — run-dependent Undef input (INDETERMINATE)
// TestIndet's `z` is Undef because `divisor` is zero; change `divisor` and
// the constraint resolves.
//
// This file must contain no `auto` param. `reify test` resolves autos, so an
// auto in TestIndet would be solved and its verdict would stop being
// Indeterminate.
// Used by test_command_on_mixed_file_shows_summary.

@test structure TestPass {
    param x: Length = 5mm
    constraint x > 0mm
}

@test structure TestFail {
    param y: Length = -3mm
    constraint y > 0mm
}

@test structure TestIndet {
    param divisor: Int = 0
    let z = 1mm / divisor
    constraint z > 0.1mm && z < 1mm
}
