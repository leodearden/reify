// sweep_direction_forms_rejections.ri — CLI check fixture for direction-typing
// ι-b (#9647): each retired scalar sweep arity is an arity error that teaches
// the Direction form.

module sweep_direction_forms_rejections

structure def ScalarRevolve {
    let g = revolve(rectangle(20mm, 10mm), -10mm, 0mm, 0mm, 0.0, 1.0, 0.0, 90deg)
}

structure def ScalarRevolveFull {
    let g = revolve_full(rectangle(20mm, 10mm), -10mm, 0mm, 0mm, 0.0, 1.0, 0.0)
}

structure def StringSenseExtrudeInfinite {
    let g = extrude_infinite(circle(5mm), 0, 0, 1, "both")
}
