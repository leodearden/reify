// #7175 positive fixture: a DOTTED sub-port connect that is direction-correct
// (out -> in). Resolving dotted endpoints must not turn well-formed assemblies
// red — this pins exit 0 for the shape the corpus actually uses.
trait T { param d : Length }

structure def Src {
    port p : out T { param d : Length = 1mm }
}

structure def Dst {
    port q : in T { param d : Length = 1mm }
}

structure def Asm {
    sub a : Src
    sub b : Dst
    connect a.p -> b.q
}
