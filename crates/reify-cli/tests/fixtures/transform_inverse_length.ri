// transform_inverse_length.ri — the INSEPARABLE control for
// transform_inverse_dimensionless.ri.
//
// Without it, the sibling's "exits 1" assertion could pass for the wrong reason
// (the builtin broken outright rather than gated). A LENGTH translation must
// still exit 0 and print the inverse with an SI-metre translation.
//
// Declares its module explicitly, for the sibling's reason.

module transform_inverse_length

structure def TransformInverseLength {
    let t = transform_inverse(transform3(orient_identity(), vec3(5mm, 0mm, 0mm)))
}
