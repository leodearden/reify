module mirror_bare_origin_purpose

// mirror_bare_origin_purpose.ri — task 5748 (PRD docs/prds/v0_6/check-diagnostic-truthfulness.md,
// leaf β), the `--purpose` (sub-path (c)) twin of `mirror_bare_origin.ri`.
//
// Same bare-Int-origin `mirror(...)` anti-pattern (examples/best_practices/
// symmetry_mirror.ri:27, `// WRONG — bare-0 origin`), plus a purpose block
// modelled structurally on `gdt_illegal_modifier_purpose.ri`: the purpose
// constraint is deliberately SATISFIABLE, so the only new observable under
// leaf β is the geometry-compile diagnostic — never a constraint violation and
// never a purpose-activation failure.
//
// Verified baseline with the pre-change binary (before D1/D2):
//
//   reify check --purpose mfg_ready=MirrorBareOriginPurpose <this file>
//     stdout: the `purpose:mfg_ready@…` injected-constraint verdict + satisfied
//             summary
//     stderr: does NOT contain "failed to compile geometry operation"
//     exit 0
//
// After leaf β the geometry-compile error appears on stderr exactly once; the
// exit code stays 0 until leaf γ (#5403) lands the Severity::Error gate.

structure MirrorBareOriginPurpose {
    param width         : Length = 80mm
    param arm_width     : Length = 8mm
    param arm_thickness : Length = 5mm

    let arm = box(width, arm_width, arm_thickness)

    // WRONG on purpose — bare-Int origin components (should be `0mm`).
    let reflected = mirror(arm, 0, 0, 0, 1, 0, 0)

    param geometry : Solid = union(arm, reflected)
}

purpose mfg_ready(subject : Structure) {
    constraint subject.width > 0mm
}
