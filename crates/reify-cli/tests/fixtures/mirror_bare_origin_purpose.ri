module mirror_bare_origin_purpose

// mirror_bare_origin_purpose.ri — task 5748 (PRD docs/prds/v0_6/check-diagnostic-truthfulness.md,
// leaf β), the `--purpose` (sub-path (c)) twin of `mirror_bare_origin.ri`.
//
// Same bare-origin `mirror(...)` anti-pattern in its DECODED-VALUE form —
// `plane_yz(0)` takes a bare-Int offset where `0mm` is required — plus a purpose
// block modelled structurally on `gdt_illegal_modifier_purpose.ri`: the purpose
// constraint is deliberately SATISFIABLE, so the only new observable under
// leaf β is the geometry-compile diagnostic — never a constraint violation and
// never a purpose-activation failure.
//
// Task 5662 moved this fixture off the 7-arg scalar form, exactly as it moved
// its non-purpose twin; the reason is stated once, on the `mirror` /
// `circular_pattern` arms of `builtin_arg_slots` in
// `crates/reify-compiler/src/builtin_signatures.rs`.
//
// Verified baseline, RE-MEASURED at task 5746 (units-length ε, R11 —
// `docs/prds/v0_6/units-length-gate-completion.md`), which is what changed the
// stderr below: `plane_yz(0)` is now rejected at the PRODUCER, so `mirror` never
// receives a Plane and the consumer-side ox/oy/oz triple is no longer reached.
// The fixture stays deliberately BARE — it is now a test OF that gate.
//
//   reify check --purpose mfg_ready=MirrorBareOriginPurpose <this file>   exit 1
//     stdout: "  OK purpose:mfg_ready@MirrorBareOriginPurpose#constraint[0]"
//             "All constraints satisfied."
//     stderr: error: plane_yz: offset argument expects Length, got Int; pass a
//                    dimensioned length such as `5mm`
//             error: failed to compile geometry operation: mirror: expected a
//                    Plane value, got undef                     [exactly ONCE]
//             error: failed to compile geometry operation: unresolvable
//                    GeomRef::Step(1) — index out of bounds or INVALID handle
//
//   The compile-gate line is emitted per realization pass, so `reify build` on
//   this file prints it TWICE (measured) and `check`'s accumulating dedup
//   collapses it to one — which is the property the count pin asserts.
//
// Before leaf β the stderr did NOT contain "failed to compile geometry
// operation" at all.  After it, the error appears exactly once.  `check` exits
// non-zero because `check_gating_error` gates on any non-allowlisted
// Severity::Error in the merged set (#5403), and no CHECK_ERROR_EXIT_ALLOWLIST
// entry covers the plane_yz producer rejection or the geometry-compile family —
// deliberately: they are genuine design errors, as `reify eval` agrees.
// Asserted by cli_check.rs::check_purpose_surfaces_geometry_compile_error and
// check_purpose_does_not_contradict_definite_verdicts.

structure MirrorBareOriginPurpose {
    param width         : Length = 80mm
    param arm_width     : Length = 8mm
    param arm_thickness : Length = 5mm

    let arm = box(width, arm_width, arm_thickness)

    // WRONG on purpose — bare-Int plane offset (should be `0mm`).
    let reflected = mirror(arm, plane_yz(0))

    param geometry : Solid = union(arm, reflected)
}

purpose mfg_ready(subject : Structure) {
    constraint subject.width > 0mm
}
