// CLI test fixture: one @test structure whose constraint is indeterminate.
// `tolerance` is Undef because `divisor` is zero. The Undef comes from a
// run-dependent value: change `divisor` and the constraint resolves.
//
// This file must contain no `auto` param. `reify test` resolves autos, so an
// auto here would be solved and the verdict would stop being Indeterminate.
// Used by test_command_on_indeterminate_file_exits_success.

@test structure TestUndefTolerance {
    param divisor: Int = 0
    let tolerance = 1mm / divisor
    constraint tolerance > 0.1mm && tolerance < 1mm
}
