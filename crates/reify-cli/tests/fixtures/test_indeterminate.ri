// CLI test fixture: one @test structure, Indeterminate via a run-dependent Undef.
// Used by test_command_on_indeterminate_file_exits_success and
// test_command_prints_the_reason_behind_an_indeterminate.

@test structure TestUndefTolerance {
    param divisor: Int = 0
    let tolerance = 1mm / divisor
    constraint tolerance > 0.1mm && tolerance < 1mm
}
