// affine_scale_dim.ri — CLI eval fixture: a dimensioned scale factor is rejected.
//
// affine_scale(2mm, 1.0, 1.0) returns Value::Undef (the linear part of an affine
// map is dimensionless — G6), and the post-Undef geometry diagnose hook must emit
// on stderr:
//   warning: affine_scale: scale factors must be dimensionless (Real) ...
// `reify eval` still exits 0 (the diagnostic is a Warning, not an Error).
//
// Lives in tests/fixtures/ (NOT examples/) since it intentionally triggers a
// runtime Warning diagnostic.
//
// Declares its module explicitly: without it, `reify eval` also emits
// W_MODULE_DECL_MISSING ("expected `module affine_scale_dim`"), whose text
// contains the substring "affine_scale". The old CLI assertion was the
// conjunction `contains("affine_scale") && contains("dimensionless")`, so that
// warning independently supplied the first conjunct and left only
// "dimensionless" doing real work — half-strength, not vacuous (the module
// warning says neither "dimensionless" nor "degenerate", so the real
// diagnostic could not have been absent). Hence the decl here plus a single
// contiguous anchor in cli_affine_eval.rs (task 6155).

module affine_scale_dim

structure def AffineScaleDim {
    let m = affine_scale(2mm, 1.0, 1.0)
}
