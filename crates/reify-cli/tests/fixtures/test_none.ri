// CLI test fixture: a file with no @test annotations at all.
// The test runner returns an empty result set, and `reify test` reports that
// no tests ran instead of a passing summary.
// Used by test_command_on_no_tests_file_exits_success.

structure def Bracket {
    param width: Length = 80mm
    param height: Length = 100mm
    constraint width > 0mm
    constraint height > 0mm
}
