// affine_scale_zero.ri — CLI eval fixture: a zero scale factor is degenerate.
//
// affine_scale(0.0, 1.0, 1.0) returns Value::Undef (det=0, non-invertible), and
// the post-Undef geometry diagnose hook must emit on stderr:
//   warning: affine_scale dropped: factor=0 produces a degenerate (det=0) ...
// `reify eval` still exits 0 (the diagnostic is a Warning, not an Error).
//
// Lives in tests/fixtures/ (NOT examples/) since it intentionally triggers a
// runtime Warning diagnostic.
//
// Declares its module explicitly: without it, `reify eval` also emits
// W_MODULE_DECL_MISSING ("expected `module affine_scale_zero`"), whose text
// contains the substring "affine_scale". The old CLI assertion was the
// conjunction `contains("affine_scale") && contains("degenerate")`, so that
// warning independently supplied the first conjunct and left only
// "degenerate" doing real work — half-strength, not vacuous (the module
// warning says neither "degenerate" nor "dimensionless", so the real
// diagnostic could not have been absent). Hence the decl here plus a single
// contiguous anchor in cli_affine_eval.rs (task 6155).

module affine_scale_zero

structure def AffineScaleZero {
    let m = affine_scale(0.0, 1.0, 1.0)
}
