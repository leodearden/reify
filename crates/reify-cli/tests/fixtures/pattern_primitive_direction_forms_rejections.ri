// pattern_primitive_direction_forms_rejections.ri — CLI check fixture for
// direction-typing ι-c (#9648): each retired scalar call is an arity error
// that teaches the Direction form (for circular_pattern, its Axis form).

module pattern_primitive_direction_forms_rejections

structure def ScalarHalfSpace {
    let g = half_space(0mm, 0mm, 0mm, 0, 0, 1)
}

structure def ScalarArc {
    let g = arc(0mm, 0mm, 0mm, 5mm, 0deg, 90deg, 0, 0, 1)
}

structure def ScalarLinearPattern {
    let b = box(2mm, 2mm, 2mm)
    let g = linear_pattern(b, 1, 0, 0, 3, 5mm)
}

structure def ScalarLinearGrid {
    let b = box(2mm, 2mm, 2mm)
    let g = linear_pattern_2d(b, 1, 0, 0, 2, 5mm, 0, 1, 0, 2, 5mm)
}

structure def ScalarCircularRing {
    let b = box(2mm, 2mm, 2mm)
    let g = circular_pattern(b, 0mm, 0mm, 0mm, 0, 0, 1, 4, 360deg)
}
