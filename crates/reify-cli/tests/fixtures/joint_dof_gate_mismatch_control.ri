// #8740 (compiler-declaration-passes B12): the control — joint_dof_gate_error_type.ri
// with each `Blorp` read as `Angle`, so no gate trips and each joint draws the
// joint DOF verdict.

module joint_dof_gate_mismatch_control

joint j(a: Axis, b: Axis) with angle: Angle = concentric(a, b)

joint k(a: Axis, b: Axis) with { angle: Angle, x: Angle } = concentric(a, b)
