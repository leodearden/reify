// pattern_primitive_direction_forms_eval.ri — CLI eval fixture for
// direction-typing ι-c (#9648): the Direction-form twins of the retired scalar
// primitives and patterns build the same solids, so each member prints the
// string the scalar form printed.

module pattern_primitive_direction_forms_eval

structure def HalfSpaceClip {
    let v = volume(intersection(half_space(point3(0mm, 0mm, 0mm), dir(0, 0, 1)), box(20mm, 20mm, 20mm)))
}

structure def QuarterArc {
    let a = arc(point3(0mm, 0mm, 0mm), 5mm, 0deg, 90deg, dir(0, 0, 1))
    let len = length(a)
}

structure def LinearRow {
    let v = volume(linear_pattern(box(2mm, 2mm, 2mm), dir(1, 0, 0), 3, 5mm))
}
