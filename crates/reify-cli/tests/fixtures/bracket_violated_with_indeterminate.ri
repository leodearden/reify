// `tolerance` is Undef because `divisor` is zero. The Undef comes from a
// run-dependent value: change `divisor` and the constraint that reads
// `tolerance` resolves.
//
// This file must contain no `auto` param. A constraint that reads an Undef
// operand AND an auto makes the solve Infeasible (`comparison_residual` scores
// a non-numeric operand 1.0), which is an error that flips the exit code. An
// auto-free Undef is dropped from the solve, so the verdicts here do not depend
// on whether the driver solves.
structure Bracket {
    param width: Length = 80mm
    param height: Length = 100mm
    param thickness: Length = 1mm
    param divisor: Int = 0

    let tolerance = 1mm / divisor

    constraint thickness > 2mm
    constraint tolerance > 0.1mm && tolerance < 1mm

    let body = box(width, height, thickness)
}
