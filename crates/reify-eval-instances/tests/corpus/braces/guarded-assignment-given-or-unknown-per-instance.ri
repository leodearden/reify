structure def Plate {
    param t : Length = auto
    param w : Length = auto
    constraint t >= 3mm
    constraint w == 2 * t
}
structure def Asm {
    param thick : Bool = true
    param thin : Bool = false
    sub a : Plate {
        t = 6mm where thick
    }
    sub b : Plate {
        t = 6mm where thin
        constraint t <= 3mm
    }
}
