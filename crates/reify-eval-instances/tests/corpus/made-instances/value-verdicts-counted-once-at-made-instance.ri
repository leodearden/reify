structure def Plate  { param t : Length   constraint t >= 3mm   pub let area = t * 40mm }
structure def Widget { param p : Plate   constraint p.t > 5mm }
structure def Asm {
    let c = Plate(t: 1mm)
    let e = c
    let xs = [c, Plate(t: 5mm)]
    let a = xs[0].area
    sub d = Widget(p: c)
    sub w = Widget(p: c)
}
