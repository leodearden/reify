structure def Beam {
    param len : Length
    constraint len >= 7mm
    constraint len <= 7mm
}
structure def Asm {
    param use_b : Bool = false
    let x : Length = auto
    constraint x == 20mm
    sub b : Beam where use_b {
        len = auto
    }
    constraint self.b.len == x / 2 where use_b
}
