// Test fixture for task 6643 (leaf-scope Stage A's value-diff walk to PRD line 33).
//
// DELIBERATELY GEOMETRY-FREE: Stage A (`reify_eval::stage_a_eligible`) is pure
// Rust and calls no geometry kernel, so the guard that consumes this fixture
// must run in EVERY build profile, including a stub build with neither gmsh nor
// OCCT.
//
// `is_wide` is the SAME shape as a compiler-synthesized `__guard_N` block/where
// guard cell (`ValueCellKind::Let` + `Type::Bool`) but is NOT registered in
// `graph.structure_controlling` — that set membership, not the cell's kind or
// type, is the discriminator leaf scoping turns on. Ticking `width` 10mm ->
// 10.5mm against `depth` 10mm flips `is_wide`, so the derived cell provably
// differs on a purely dimensional edit. The structure-controlling half of the
// pairing is `morph_derived_let_guarded.ri`.

structure MorphDerivedLet {
    param width: Length = 10mm
    param depth: Length = 10mm

    let is_wide = width > depth
}
