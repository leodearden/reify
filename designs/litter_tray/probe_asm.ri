module probe_asm

structure def Brick {
    param geometry : Solid = box(20mm, 10mm, 5mm)
}

structure def Pair {
    sub a : Brick at transform3(orient_identity(), vec3(20mm, 0mm, 0mm))
    sub b : Brick at transform3(orient_axis_angle(vec3(0, 0, 1), 3.141592653589793rad), vec3(0mm - 20mm, 0mm, 0mm))
}
