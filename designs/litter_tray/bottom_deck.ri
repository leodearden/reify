module bottom_deck

// Two-deck cat litter tray — BOTTOM DECK (collection tray), v3 (round 3, 2026-09-03).
//
// Concept: compressed wood-pellet litter lives in the top deck (a sieve).
// Urine-soaked sawdust falls through into this bottom deck; the ledge below
// the rim locates the top deck positively ("drops down into it slightly").
//
// Print plan (Snapmaker U1, 270×270×270, PETG):
//   - Printed floor-down, walls vertical → no supports.
//   - The internal ledge is the top of the thicker lower wall, so it is fully
//     supported material — zero overhang by construction.
//   - Full tray is 480×260; it exceeds the bed in X, so it splits into two
//     halves at x=0 (bottom_deck_split.ri). This file is the monolithic
//     reference: same section, same features, no seam.
//
// v3 construction (selector-driven; replaces the v1 union-of-boxes-and-
// cylinders idiom now that curated 3-arg fillets reach the designer surface,
// task #5208):
//   - Plan corners: 3-arg fillet of each blank box's vertical edges
//     (`edges_parallel_to` +Z), radius stepped per wall offset so wall
//     thickness stays uniform around the corners.
//   - Edge softening: sequential 3-arg fillets on the COMPOSED body selecting
//     each horizontal edge loop by height (`edges_at_height`): rim, ledge,
//     floor junction (which also catches the pedestal bases and the hood
//     seams — the features are unioned BEFORE the fillet chain), base.
//   - Intermediates are `aux let` (hidden in the viewport by default).
//
// Features:
//   - Mid-span pedestals Ø20 at (±120, 0), floor → ledge level, bearing on
//     the top deck's Ø26 solid pads (top_deck.pad_x / pad_r).
//   - Hooded finger pockets in both end walls (Leo, 2026-09-03): a 60×22
//     stadium slot through the lower wall, closed on the cavity side by a
//     printed hood so the pocket is spill-proof when the tray is tilted to
//     empty it. The bed envelope leaves no room for any external grip.

structure def BottomDeck : Rigid {
    // ── Overall envelope ────────────────────────────────────────────────
    param outer_length  : Length = 480mm   // X — split into two prints
    param outer_width   : Length = 260mm   // Y — fits the bed directly
    param wall_height   : Length = 80mm    // Z, floor bottom to rim top
    param corner_radius : Length = 25mm    // plan-view outer corner radius

    // ── Wall / ledge cross-section (matches bottom_deck_split.ri) ───────
    param upper_wall   : Length = 2.4mm    // wall above the ledge
    param ledge_width  : Length = 5mm      // horizontal seat for the top deck
    param recess_depth : Length = 15mm     // ledge sits this far below the rim
    param floor_thickness : Length = 4mm

    // ── Edge softening (selector-driven 3-arg fillets) ──────────────────
    param rim_fillet   : Length = 1mm      // both rim edges (rim is only upper_wall wide)
    param ledge_fillet : Length = 1mm      // both ledge edges (seat must stay flat)
    param floor_fillet : Length = 5mm      // floor-wall junction + feature seams (cleanability)
    param base_fillet  : Length = 2mm      // outer base perimeter

    // ── Mid-span pedestals (support the top deck's solid pads) ──────────
    param pedestal_x : Length = 120mm      // MUST match top_deck.pad_x
    param pedestal_r : Length = 10mm
    param top_pad_r  : Length = 13mm       // top_deck.pad_r (interface echo)

    // ── Hooded finger pockets (one per end wall) ────────────────────────
    param slot_w : Length = 60mm           // stadium slot, total width
    param slot_h : Length = 22mm
    param slot_z : Length = 47mm           // slot centre height
    param hood_w : Length = 70mm           // hood block, plan width (y)
    param hood_d : Length = 25mm           // hood block, depth into the cavity (x)
    param hood_h : Length = 57mm           // hood block height above the floor
    param hood_t : Length = 2.4mm          // hood wall / roof thickness

    param material : Material = Material(name: "PETG", density: 1270kg/m^3, youngs_modulus: 2.1GPa)

    // ── Derived section dims ────────────────────────────────────────────
    let lower_wall = upper_wall + ledge_width        // wall below the ledge
    let ledge_z    = wall_height - recess_depth      // ledge height above base
    let inner_length = outer_length - 2 * lower_wall // main cavity plan dims
    let inner_width  = outer_width  - 2 * lower_wall
    let recess_length = outer_length - 2 * upper_wall
    let recess_width  = outer_width  - 2 * upper_wall
    let pedestal_h = ledge_z - floor_thickness
    let hood_top   = floor_thickness + hood_h        // hood roof top, must clear the ledge
    let inner_x    = inner_length / 2                // end-wall inner face

    // Sawdust capacity between emptyings (rectangular approximation, minus
    // the two pedestals and the two hood blocks).
    let capacity = (ledge_z - floor_thickness) * inner_length * inner_width
                 - 2.0 * 3.14159265 * pedestal_r * pedestal_r * pedestal_h
                 - 2.0 * hood_d * hood_w * hood_h

    // ── Printability & sanity constraints ───────────────────────────────
    let bed_limit = 265mm                            // U1 bed 270mm minus margin
    constraint outer_width <= bed_limit              // each half prints flat
    constraint outer_length <= 2 * bed_limit         // two-part split in X
    constraint corner_radius > lower_wall + 2mm      // inner corners stay round
    constraint corner_radius < outer_width / 4
    constraint upper_wall >= 1.6mm                   // ≥4 perimeters of PETG
    constraint ledge_width >= 3mm                    // usable seat for top deck
    constraint recess_depth >= 8mm                   // positive engagement
    constraint recess_depth < wall_height / 3
    constraint floor_thickness >= 2mm
    constraint 2 * rim_fillet < upper_wall           // both rim edges filleted
    constraint 2 * ledge_fillet < ledge_width        // flat seat survives
    constraint floor_fillet < ledge_z / 4
    constraint base_fillet < floor_thickness
    constraint pedestal_r <= top_pad_r - 2mm         // lands fully on the pad
    constraint pedestal_x + pedestal_r < inner_x - hood_d - floor_fillet   // clear of the hood
    constraint hood_top + 4mm <= ledge_z             // hood clears the top deck's floor
    constraint slot_z + slot_h / 2 <= hood_top - hood_t   // channel closed by the hood roof
    constraint slot_z - slot_h / 2 >= floor_thickness + 10mm   // sill above the floor
    constraint slot_w + 2mm <= hood_w - 2 * hood_t   // slot inside the pocket width
    constraint hood_d - hood_t >= 20mm               // finger depth
    constraint hood_d - hood_t <= 30mm               // roof bridge stays printable

    // ── Geometry ────────────────────────────────────────────────────────
    let recess_r = corner_radius - upper_wall
    let main_r   = corner_radius - lower_wall
    let recess_h = recess_depth + 20mm               // cavity pokes above the rim
    let end_x    = outer_length / 2                  // end-wall mid-plane
    let slot_flat = slot_w - slot_h                  // straight part of the slot
    let void_d = hood_d - hood_t                     // pocket void (inside the hood)
    let void_w = hood_w - 2 * hood_t
    let void_h = hood_h - hood_t

    // Shell: outer envelope minus recess cavity minus main cavity. Each
    // rounded prism is a box blank with its vertical edges filleted to the
    // stepped corner radius (`edges_parallel_to` +Z). NOT `rounded_box`: its
    // boolean-compose lowering leaves seam edges in the rim-height faces and
    // every later `edges_at_height` fillet then fails in OCCT (round-3 finding,
    // 2026-09-03 — see dogfood-findings.md).
    let up = vec3(0.0, 0.0, 1.0)
    aux let outer_blank  = translate(box(outer_length, outer_width, wall_height), 0mm, 0mm, wall_height / 2)
    aux let outer        = fillet(outer_blank, edges_parallel_to(outer_blank, up, 1deg), corner_radius)
    aux let recess_blank = translate(box(recess_length, recess_width, recess_h), 0mm, 0mm, ledge_z + recess_h / 2)
    aux let recess_cut   = fillet(recess_blank, edges_parallel_to(recess_blank, up, 1deg), recess_r)
    aux let main_blank   = translate(box(inner_length, inner_width, wall_height), 0mm, 0mm, floor_thickness + wall_height / 2)
    aux let main_cut     = fillet(main_blank, edges_parallel_to(main_blank, up, 1deg), main_r)
    aux let hollowed     = difference(difference(outer, recess_cut), main_cut)

    // Features union on BEFORE the fillet chain: pedestals + solid hood blocks
    // (their pocket voids are cut last).
    aux let featured = union_all(
        hollowed,
        translate(cylinder(pedestal_r, pedestal_h), pedestal_x, 0mm, floor_thickness),
        translate(cylinder(pedestal_r, pedestal_h), 0mm - pedestal_x, 0mm, floor_thickness),
        translate(box(hood_d, hood_w, hood_h), inner_x - hood_d / 2, 0mm, floor_thickness + hood_h / 2),
        translate(box(hood_d, hood_w, hood_h), hood_d / 2 - inner_x, 0mm, floor_thickness + hood_h / 2)
    )

    // Soften each horizontal edge loop on the composed body, top down.
    aux let rim_soft   = fillet(featured,   edges_at_height(featured,   wall_height,     0.5mm), rim_fillet)
    aux let ledge_soft = fillet(rim_soft,   edges_at_height(rim_soft,   ledge_z,         0.5mm), ledge_fillet)
    aux let floor_soft = fillet(ledge_soft, edges_at_height(ledge_soft, floor_thickness, 0.5mm), floor_fillet)
    aux let base_soft  = fillet(floor_soft, edges_at_height(floor_soft, 0mm,             0.5mm), base_fillet)

    // Finger channels, cut LAST: pocket void inside each hood (overlapping 1mm
    // into the end wall) + stadium slot through the lower wall.
    aux let channels = union_all(
        translate(box(void_d + 1mm, void_w, void_h), inner_x - void_d / 2 + 0.5mm, 0mm, floor_thickness + void_h / 2),
        translate(box(4 * lower_wall, slot_flat, slot_h), end_x, 0mm, slot_z),
        translate(rotate(cylinder(slot_h / 2, 4 * lower_wall), 0, 1, 0, 90deg), end_x - 2 * lower_wall, slot_flat / 2, slot_z),
        translate(rotate(cylinder(slot_h / 2, 4 * lower_wall), 0, 1, 0, 90deg), end_x - 2 * lower_wall, 0mm - slot_flat / 2, slot_z),
        translate(box(void_d + 1mm, void_w, void_h), void_d / 2 - inner_x - 0.5mm, 0mm, floor_thickness + void_h / 2),
        translate(box(4 * lower_wall, slot_flat, slot_h), 0mm - end_x, 0mm, slot_z),
        translate(rotate(cylinder(slot_h / 2, 4 * lower_wall), 0, 1, 0, 90deg), 0mm - end_x - 2 * lower_wall, slot_flat / 2, slot_z),
        translate(rotate(cylinder(slot_h / 2, 4 * lower_wall), 0, 1, 0, 90deg), 0mm - end_x - 2 * lower_wall, 0mm - slot_flat / 2, slot_z)
    )

    param geometry : Solid = difference(base_soft, channels)

    sub display = DisplayOutput(subject: geometry)
}
