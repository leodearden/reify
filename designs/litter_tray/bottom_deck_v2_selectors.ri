module bottom_deck_v2_selectors

// Two-deck cat litter tray — BOTTOM DECK (collection tray), v2.
//
// Concept: compressed wood-pellet litter lives in the top deck (a sieve).
// Urine-soaked sawdust falls through into this bottom deck; the ledge below
// the rim locates the top deck positively ("drops down into it slightly").
//
// Print plan (Snapmaker U1, 270×270×270, PETG):
//   - Printed floor-down, walls vertical → no supports.
//   - The internal ledge is the top of the thicker lower wall, so it is fully
//     supported material — zero overhang by construction.
//   - Full tray is 480×260; it exceeds the bed in X, so it splits into two
//     halves at x=0 with a joining feature (separate design step).
//
// v2 construction (selector-driven, replaces v1's union-of-boxes-and-cylinders
// idiom — kept in bottom_deck_v1_boolean.ri for comparison):
//   - Plan corners: 3-arg fillet of each blank box's vertical edges
//     (edges_parallel_to +Z), radius stepped per wall offset so wall thickness
//     stays uniform around the corners.
//   - Edge softening: sequential 3-arg fillets on the COMPOSED body, selecting
//     each horizontal edge loop by exact height (edges_at_height): rim (z=H),
//     ledge (z=ledge_z), floor junction (z=floor), base perimeter (z=0).
//   - Every fillet target must be a named let (the selector references the
//     same solid), so intermediates realize and render — live evidence for
//     task 5195 (hidden-by-default intermediates).

structure def BottomDeck : Rigid {
    // ── Overall envelope ────────────────────────────────────────────────
    param outer_length  : Length = 480mm   // X — split into two prints
    param outer_width   : Length = 260mm   // Y — fits the bed directly
    param wall_height   : Length = 80mm    // Z, floor bottom to rim top
    param corner_radius : Length = 25mm    // plan-view outer corner radius

    // ── Wall / ledge cross-section ──────────────────────────────────────
    param upper_wall   : Length = 2.4mm    // wall above the ledge
    param ledge_width  : Length = 5mm      // horizontal seat for the top deck
    param recess_depth : Length = 15mm     // ledge sits this far below the rim
    param floor_thickness : Length = 4mm

    // ── Edge softening (selector-driven 3-arg fillets) ──────────────────
    param rim_fillet   : Length = 1mm      // both rim edges (rim is only upper_wall wide)
    param ledge_fillet : Length = 1mm      // both ledge edges (seat must stay flat)
    param floor_fillet : Length = 5mm      // floor-wall junction (cleanability)
    param base_fillet  : Length = 2mm      // outer base perimeter

    param material : Material = Material(name: "PETG", density: 1270kg/m^3, youngs_modulus: 2.1GPa)

    // ── Derived section dims ────────────────────────────────────────────
    let lower_wall = upper_wall + ledge_width        // wall below the ledge
    let ledge_z    = wall_height - recess_depth      // ledge height above base
    let inner_length = outer_length - 2 * lower_wall // main cavity plan dims
    let inner_width  = outer_width  - 2 * lower_wall
    let recess_length = outer_length - 2 * upper_wall
    let recess_width  = outer_width  - 2 * upper_wall

    // Sawdust capacity between emptyings (rectangular approximation).
    let capacity = (ledge_z - floor_thickness) * inner_length * inner_width

    // ── Printability & sanity constraints ───────────────────────────────
    let bed_limit = 265mm                            // U1 bed 270mm minus margin
    constraint outer_width <= bed_limit              // each half prints flat
    constraint outer_length <= 2 * bed_limit         // two-part split in X
    constraint corner_radius > lower_wall + 2mm      // inner corners stay round
    constraint corner_radius < outer_width / 4
    constraint upper_wall >= 1.6mm                   // ≥4 perimeters of PETG
    constraint ledge_width >= 3mm                    // usable seat for top deck
    constraint recess_depth >= 8mm                   // positive engagement
    constraint recess_depth < wall_height / 3
    constraint floor_thickness >= 2mm
    constraint 2 * rim_fillet < upper_wall           // both rim edges filleted
    constraint 2 * ledge_fillet < ledge_width        // flat seat survives
    constraint floor_fillet < ledge_z / 4
    constraint base_fillet < floor_thickness

    // ── Geometry ────────────────────────────────────────────────────────
    let up = vec3(0.0, 0.0, 1.0)
    let recess_h = recess_depth + 20mm               // cavity pokes above the rim

    // Outer envelope: box with vertical edges filleted to the corner radius.
    let outer_blank = translate(box(outer_length, outer_width, wall_height), 0mm, 0mm, wall_height / 2)
    let outer = fillet(outer_blank, edges_parallel_to(outer_blank, up, 1deg), corner_radius)

    // Recess cavity: ledge level up past the rim, upper_wall-thick walls.
    let recess_blank = translate(box(recess_length, recess_width, recess_h), 0mm, 0mm, ledge_z + recess_h / 2)
    let recess_cut = fillet(recess_blank, edges_parallel_to(recess_blank, up, 1deg), corner_radius - upper_wall)

    // Main cavity: floor level up past the rim, lower_wall-thick walls.
    let main_blank = translate(box(inner_length, inner_width, wall_height), 0mm, 0mm, floor_thickness + wall_height / 2)
    let main_cut = fillet(main_blank, edges_parallel_to(main_blank, up, 1deg), corner_radius - lower_wall)

    let hollowed = difference(difference(outer, recess_cut), main_cut)

    // Soften each horizontal edge loop on the composed body, top down.
    let rim_soft   = fillet(hollowed,   edges_at_height(hollowed,   wall_height,     0.5mm), rim_fillet)
    let ledge_soft = fillet(rim_soft,   edges_at_height(rim_soft,   ledge_z,         0.5mm), ledge_fillet)
    let floor_soft = fillet(ledge_soft, edges_at_height(ledge_soft, floor_thickness, 0.5mm), floor_fillet)
    param geometry : Solid = fillet(floor_soft, edges_at_height(floor_soft, 0mm, 0.5mm), base_fillet)

    sub display = DisplayOutput(subject: geometry)
}
