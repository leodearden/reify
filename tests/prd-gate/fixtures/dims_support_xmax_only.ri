module dims_support_xmax_only

// PRD docs/prds/v0_6/elastic-modal-trampoline-factoring.md leaf μ (BT5b). A
// shell-classified dims plate (50 x 10 x 1 mm, aspect 0.02 < shell_threshold 0.2,
// ShellForce Auto). At main 1b06f93151 this emits the FeaUnderConstrained "supports present, none root" advisory while the solve clamps the root anyway. After μ (R3): reify eval exits 1 with one FeaDimsSupportNotRealized Error naming x_max instead.
structure P {
    param length : Length = 50mm
    param width  : Length = 10mm
    param height : Length = 1mm
    let material = Steel_AISI_1045()
    let body = box(length, width, height)
    let tip_load = PointLoad(point: "tip", force: 10.0)
    let result = solve_elastic_static(material, length, width, height, [tip_load], [FixedSupport(target: "x_max")], ElasticOptions())
    let max_vm = result.max_von_mises
}
