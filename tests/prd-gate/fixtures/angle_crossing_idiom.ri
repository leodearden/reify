module angle_crossing_idiom

structure AngleCrossingIdiom {
    param s : Length = 5mm
    param r : Length = 2mm
    let theta : Angle = (s / r) * 1rad
    let ratio = theta / 1rad
    let omega = 6.283185 * 1rad / 1s
}
