// driver-contract PRD, baseline B3: a kernel-measured DFM rule is measured by
// `reify check` (which attaches OpenVDB when the module carries a thickness rule)
// and is INVISIBLE to `reify eval` and `reify report`, which never attach it.
//
// Measured at main 9a992fc2f2 (2026-08-26), target/debug/reify:
//   reify check        -> exit 1, "error: E_DFM_MIN_WALL" + "error: E_DFM_MIN_FEATURE"
//   reify eval         -> exit 0, ZERO DFM diagnostics; prints values as if clean
//   reify report --bom -> exit 0, ZERO DFM diagnostics
//
// Geometry calibration is inherited verbatim from
// crates/reify-cli/tests/fixtures/dfm_thickness_error.ri (task 4638): the 0.5mm Z
// offset puts the medial plane at a non-integer voxel index so the d_plus/d_minus
// equality test passes.
//
// Post-fix (leaves γ, δ): eval and report attach the same measurement arm and the
// same two E_DFM_* errors appear under all three drivers.
module driver_contract_dfm_measurement_arm
import std.process

structure def Milling : Subtracting {
    param duration          : Time   = 30min
    param cost              : Money  = 10USD
    param tool_access       : Solid  = box(200mm, 200mm, 200mm)
    param min_feature_size  : Length = 2mm
    param achievable_finish : Length = 0.01mm
}

structure def ThicknessRuleError : DFMRule {
    param rule_name  : String      = "thickness-check-error"
    param severity   : DFMSeverity = DFMSeverity.Error
    param applies_to : Process     = Milling()
    param subject    : Solid       = translate(box(14mm, 14mm, 1mm), 0mm, 0mm, 0.5mm)
}
