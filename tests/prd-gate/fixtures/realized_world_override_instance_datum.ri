// realized-world-evaluation PRD (docs/prds/v0_6/realized-world-evaluation.md) baseline, main dd2a97059a 2026-11-17.
// Row B17. Today the pattern gets undef in the default instance as well (the row B1 failure). After leaf
// alpha the default instance builds and the overridden instance must stay a loud error until leaf beta.
module realized_world_override_instance_datum

pub structure Inner {
    param size : Length = 10mm
    let ref_cyl = translate(revolve(rectangle(20mm, 10mm), -10mm, 0mm, 0mm, 0.0, 1.0, 0.0, 6.283185307179586rad), size, 0mm, 0mm)
    let body = circular_pattern(box(1mm, 1mm, 1mm), ref_cyl.axis, 4, 360deg)
}

pub structure Outer {
    sub a = Inner(size: 80mm)
    let moved = translate(self.a.body, 0mm, 0mm, 500mm)
}
