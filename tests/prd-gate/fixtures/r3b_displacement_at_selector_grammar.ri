// Fixture: R3b substrate-boundary probe. Two live, executable guards keep it
// honest today, rather than this comment:
//   - parse-shape corpus member (0 ERROR nodes): `EXPECTED_CLEAN` in
//     gui/src/__tests__/reifyGrammarCorpus.test.ts, and
//     scripts/verify.sh's `_GUI_COUPLED_RI_FIXTURES` / `_RUST_COUPLED_RI_FIXTURES`;
//   - ctor-conformance pinned-clean: `CTOR_CONFORMANCE_PINNED_CLEAN`, asserted by
//     `pinned_clean_files_emit_no_ctor_conformance_diagnostic` in
//     crates/reify-compiler/tests/harness_compilation_surface/
//     ctor_conformance_corpus_survey.rs — zero ctor-conformance diagnostics on
//     this file.
// Both guards are cited by SYMBOL, not file:line: nothing recompiles this fixture
// when those files are edited, so a pinned line number would drift silently,
// while the names stay grep-resolvable.
// Together they exercise `displacement_at`'s `location : FaceSelector`
// overload end-to-end: `reify check` on this fixture exits 0.
//
// History: originally fed a TOPOLOGY SELECTOR where `displacement_at` accepted
// only a String location, proving the eval-path selector->node resolver was
// unbuilt; the R3b resolver landed and `modal_analysis_fns.ri` added the
// `location : FaceSelector` overload the `top` argument below now resolves
// against, sharing the String overload's trampoline.
//
// PRD: docs/prds/v0_6/value-eval-geometry-addressing.md (Leaf R3b — eval-path
// selector->node resolver, the re-homed task 4122 deliverable).
//
// GRAMMAR caveat (PRD §G2): the signal's literal `+Z` does NOT parse
// (`Parse error: invalid let`); the faithful direction form is the let-bound
// `vec3(0.0, 0.0, 1.0)` and the tolerance is an angle literal `1deg`, per
// examples/kernel_queries/directional_selectors.ri:19 and
// examples/topology_selectors/fillet_top_edges.ri:43 — a parse-stage detail,
// distinct from the overload resolution the two guards above pin at the
// semantic stage.
//
// The history-construction chain (modal_analysis -> transient_response) mirrors
// examples/modal/transient_step_response.ri so `response` carries the
// DisplacementTimeHistory type the displacement_at overload-set keys on.

structure CantileverSelectorQuery {
    param length : Length = 200mm
    param width  : Length = 10mm
    param height : Length = 2mm

    let material = Steel_AISI_1045()
    let mi   = FEAMaterialInput(material: material)
    let root = FixedSupport(target: "x_min")

    let opts = ModalOptions(
        n_modes: 3,
        boundary_conditions: [root],
        damping: RayleighDamping(alpha: 0.0Hz, beta: 0.0003s),
        sigma: 0.0,
        tol: 0.000000001,
        max_iters: 200,
        reference_direction: vec3(0.0, 0.0, 1.0),
        element_order: ElementOrder.P1
    )

    let result = modal_analysis(mi.material, length, width, height, opts)

    // `at` is a topology Selector (task 4577: was String "tip"). The free-tip
    // (x_max) face is addressed kernel-free via box + faces_by_normal, the same
    // shape as examples/modal/transient_step_response.ri:101-106 — the selector
    // is never realized against a mesh, so this stays geometry-free. Let-bound
    // for the dispatcher arg-shape contract noted below.
    let part = box(length, width, height)
    let tip_dir = vec3(1.0, 0.0, 0.0)
    let tip_tol = 1deg
    let tip_face = faces_by_normal(part, tip_dir, tip_tol)

    let tip_push = StepForce(
        at: tip_face,
        direction: vec3(0.0, 0.0, 1.0),
        magnitude: 10N,
        start_time: 0s
    )
    let forcing = ForcingTimeHistory(part: Part(), sources: [tip_push])

    let t_start = 0s
    let t_end   = 0.25s
    let dt      = 0.0002s
    let response = transient_response(result, forcing, t_start, t_end, dt)

    // Topology selector over the same part box. Let-bound `dir`/`tol` mirror the
    // dispatcher arg-shape contract (selector args resolve via values.get;
    // inline vec3()/deg literals fall through to None).
    let dir  = vec3(0.0, 0.0, 1.0)
    let tol  = 1deg
    let top  = faces_by_normal(part, dir, tol)

    // R3b: feed the FaceSelector `top` to displacement_at, exercising the
    // FaceSelector overload (modal_analysis_fns.ri) added alongside the
    // original String-location form -> check exits 0.
    let tip = displacement_at(response, top, tip_push.direction)
}
