module auto_reach_conn_nested
trait Signal {}

structure ConnInner {
    param gain : Length = auto
    constraint self.gain == 10mm
}

structure ConnOuter {
    port x : out Signal {}
    port y : in Signal {}
    param gain : Length = auto
    connect x -> y : ConnInner { gain = auto }
}

structure E {
    port a : out Signal {}
    port b : in Signal {}
    connect a -> b : ConnOuter { gain = auto }
}
