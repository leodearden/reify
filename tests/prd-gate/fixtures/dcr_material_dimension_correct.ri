structure def DcrMaterialDimensionCorrect {
    let m = Material(name: "steel", density: 7850kg/m^3, youngs_modulus: 200GPa)
    let j = prb_cantilever_beam(20mm, 5mm, 0.5mm, m, point3(0mm, 0mm, 0mm), vec3(0.0, 1.0, 0.0))
}
