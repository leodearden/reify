module dwr_cantilever_qoi

// PRD docs/prds/v0_6/goal-oriented-error-estimation.md leaf γ (BT5), the
// GOAL-ORIENTED twin of dwr_cantilever_energy.ri. Byte-identical except for
// the `target_quantity_of_interest` lines: naming the mean Z-displacement over
// a 20 mm ball at the tip-face centre switches the adaptive loop to the
// dual-weighted indicator. Expected after γ lands (`reify eval`, fresh
// REIFY_CACHE_DIR): `result.qoi` is `DisplacementEstimate { value, error }` on
// the FINAL refined mesh, `result.qoi_relative_error` is `some(...)` and
// finite, and `convergence_status` is either `Converged { final_indicator }`
// with final_indicator equal to that relative error, or `NotConverged { reason }`
// with the relative error still populated — the 0.02 / 2-iteration budget does
// not guarantee convergence (the energy twin ends NotConverged at 0.10577).
//
// Measured 2026-09-11 at main 191d6c85ba: `reify check` exits 1 with
// `unknown variant 'LocalDisplacement': no enum in scope declares it` —
// `QoIDescriptor` has no variants (the leaf-γ gap). Behind that, the
// param-dependent `at:` payload would hit the leaf-α `non-constant payload
// value` rule (observed on dce_runtime_payload.ri). Nothing here evaluates
// until both land.
//
// Solver path and box placement: see dwr_cantilever_energy.ri. The QoI point
// tracks the design parameters: the tip-face centre is
// point3(length, width / 2, height / 2).
structure DwrCantileverQoi {
    param length : Length = 1000mm
    param width  : Length = 100mm
    param height : Length = 100mm

    let material = Steel_AISI_1045()

    let tip_load = PointLoad(point: "tip", force: 1000.0)
    let mount = FixedSupport(target: "root")

    let result = solve_elastic_static(
        material, length, width, height, [tip_load], [mount],
        ElasticOptions(
            adaptive: true,
            target_accuracy: 0.02,
            max_refinement_iterations: 2,
            max_dofs: 2000000,
            target_quantity_of_interest: LocalDisplacement {
                at: point3(length, width / 2.0, height / 2.0),
                radius: 20mm,
                direction: vec3(0.0, 0.0, -1.0),
            },
        )
    )
}
