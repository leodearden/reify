// PRD-gate probe fixture — engine-build-hardening leaf κ (2026-07-06).
//
// Premise probed: a mixed-kernel module (Mesh-demanded union routed to
// Manifold, OCCT BRep stages) COMBINED WITH an attribute-resolved ad-hoc
// selector (`@face("top")`) uses only EXISTING grammar and compiles today.
// κ's runtime assertion (attributes on both kernels' handles independently
// readable, no cross-kernel GeometryHandleId collision) is task #4351's
// deliverable — this fixture only pins the compile-time substrate.
//
// Syntax sources (both in-production):
//   examples/multi_kernel/manifold_boolean.ri  (cross-kernel union)
//   examples/ad_hoc_face_selector.ri           (@face attribute selector)

module engine_build_hardening_kappa_mixed_kernel_selector

structure MixedKernelSelectorProbe {
    param offset : Length = 5mm

    let box_a = box(10mm, 10mm, 10mm)
    let box_b_raw = box(10mm, 10mm, 10mm)
    let box_b = translate(box_b_raw, offset, 0mm, 0mm)
    let body = union(box_a, box_b)

    // Attribute-resolved selector against a primitive's seeded roles —
    // the TopologyAttributeTable read path that #4351 re-keys.
    let post = cylinder(4mm, 12mm)
    let top_frame = post @ face("top")
}
