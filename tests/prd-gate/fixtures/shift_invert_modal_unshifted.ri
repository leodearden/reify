// Fixture: shift-invert modal CONTROL — the unshifted (shift_frequency = 0Hz) half of the
// committed pair behind leaf δ.
//
// PRD: docs/prds/v0_6/shift-invert-eigensolve.md (leaf δ, task #7261 — the
// modal trampoline honors the shift in λ-space). The author writes the shift in
// Hz as `ModalOptions.shift_frequency` (task #6097); the trampoline converts it
// to λ = (2π·shift_frequency)² via `frequency_hz_to_eigenvalue`.
//
// PAIRED WITH: shift_invert_modal_shifted.ri. The two MODELS are identical
// except for the `shift_frequency:` literal (the headers and the `module` /
// `structure` names differ, as they must to coexist in one gate), so the ONLY
// thing that can explain a difference in their frequency pairs is the shift.
// ENFORCED by `assert_fixtures_differ_only_in_shift_frequency`, the first
// assertion of the e2e test named below — do not weaken it to prose.
//
// LIVE GUARD (cited by SYMBOL, not file:line — nothing recompiles a fixture, so
// a line number here would drift silently): `include_str!`-embedded and asserted
// by `shift_changes_the_mode_set_and_warns_once` in
// crates/reify-eval-fea-tests/tests/shift_invert_modal_e2e.rs, and registered by
// basename in scripts/verify.sh's `_RUST_COUPLED_RI_FIXTURES` so
// tests/infra/test_verify_scope.sh's PG-DRIFT scenario stays green.
//
// WHICH DISPATCH ARM THIS EXERCISES, and why that matters. `build_beam_mesh`
// (crates/reify-eval/src/modal_ops.rs) is a pure analytic Freudenthal hex-split:
// nz = 6, ny = 1, nx = round(length/height · nz) = 12, giving 13·2·7 = 182 nodes
// = 546 DOFs; the x_min face pins 14 nodes = 42 DOFs, so n_free = 504. Because
// 504 > max(64, 2·n_modes) = 64 and `routes_to_dense_fallback(504, 2)` is false,
// `solve_generalized_eigen` takes ARM 2 — `try_solve_eigen_shift_invert`, β's
// real shifted Lanczos path — NOT the dense QZ arm. A smaller beam would reach
// only the dense arm and would never touch the code this pair exists to pin.
//
// MEASURED (release `reify eval`, 2026-10-09): f = {18925.96994693253,
// 28456.125839671546} Hz, exit 0, and NO `W_ShiftSkippedModes` — σ = 0 makes
// `shift_provenance_from_factorization` return false unconditionally.
//
// GRAMMAR notes: `.ri` structure bodies are NEWLINE-separated with NO statement
// terminators (a trailing `;` is one parse error per line), and ctor args bind
// BY NAME (task 4522), so a misspelled label is the hazard — see the binding
// note in examples/modal/cantilever_beam_modes.ri.

module shift_invert_modal_unshifted

structure ShiftInvertModalUnshifted {
    param length : Length = 20mm
    param width  : Length = 10mm
    param height : Length = 10mm

    let material = Steel_AISI_1045()
    let mi   = FEAMaterialInput(material: material)
    let root = FixedSupport(target: "x_min")

    let opts = ModalOptions(
        n_modes: 2,
        boundary_conditions: [root],
        damping: NoDamping(),
        shift_frequency: 0Hz,
        tol: 0.000000001,
        max_iters: 200,
        reference_direction: vec3(0.0, 0.0, 1.0),
        element_order: ElementOrder.P1
    )

    let result = modal_analysis(mi.material, length, width, height, opts)
    let f1 = first_frequency(result)
    let f2 = mode_frequency(result, 1)
}
