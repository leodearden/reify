module driver_parity_relate_conflict
// PRD evidence: docs/prds/v0_6/solver-driver-parity.md §4.6 case 3, §5 B7.
// A provably contradictory `relate` block: one bolt cannot be concentric with two
// holes 15mm apart. relate_solve::solve_scopes has exactly one call site,
// build_with_geometry_output, so `check` never runs it.
//
// Baseline measured on main 2128c3692c (2026-08-26):
//   reify check --strict -> exit 0, "All constraints satisfied."   <-- VACUOUS
//   reify eval           -> exit 1, precise conflict diagnostic naming `concentric`
// Target after this PRD: check and check --strict exit nonzero with the conflict.
structure Bolt {
    let shank = cylinder(3mm, 20mm)
    let shank_axis : Axis = shank.axis
    let seat = rectangle(12mm, 12mm)
    let seat_plane : Plane = seat.plane
}
structure Plate {
    let body = box(80mm, 40mm, 5mm)
    let hole1 = translate(cylinder(3.2mm, 5mm), 15mm, 0mm, 0mm)
    let hole1_axis : Axis = hole1.axis
    let hole2 = translate(cylinder(3.2mm, 5mm), 30mm, 0mm, 0mm)
    let hole2_axis : Axis = hole2.axis
    let top = rectangle(80mm, 40mm)
    let top_plane : Plane = top.plane
}
structure RelateConflict {
    sub bolt : Bolt at auto
    sub plate : Plate
    relate {
        concentric(bolt.shank_axis, plate.hole1_axis)
        concentric(bolt.shank_axis, plate.hole2_axis)
        flush(bolt.seat_plane, plate.top_plane)
    }
}
