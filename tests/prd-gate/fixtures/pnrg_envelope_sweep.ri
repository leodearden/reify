// Fixture: precision-nominal α (task 6166) — SWEEP probe (non-analytic class).
//
// Copies the pnrg_envelope_sphere.ri anchor layout.  READ THAT HEADER FIRST for
// the OK trap and the validity assertion.
//
// `sweep(profile, path)` is the 2-arg GEOMETRY form.  The 4-arg
// `sweep(model, joint, range, n)` is an unrelated KINEMATIC study
// (crates/reify-compiler/src/geometry.rs:218) and must not be used here.
//
// ── PATH CHOICE IS THE COST DECISION, measured 2026-08-10 at 5db884e30b ──
//
// This class is where measurement cost bites.  At #precision(20mm):
//   sweep(circle(100mm), helix(300mm, 200mm, 900mm))     TIMEOUT > 90 s
//   sweep(rectangle(100mm,100mm), helix(300mm,200mm,900mm)) TIMEOUT > 90 s
//   sweep(circle(100mm), interp(...))                    16.13 s -> 7.583e-3 m
//   sweep(circle(100mm), bezier(...))                     < 2 s  -> 2.627e-4 m
//   sweep(circle(200mm), line_segment(...))               < 2 s  -> 1.458e-3 m
// The helix path is NOT MEASURABLE within the task's 90 s per-run budget at any
// precision tried; the B-spline (`interp`) path is, and is the genuinely
// non-analytic surface this fixture measures.  The subject below is the interp
// path for that reason — it is the finest path that stays inside the budget.
//
// REGIME PARAMETER: profile size / path curvature.  Tighten by shrinking the
// profile (fewer facets) BEFORE tightening d — see the note's ladder.
//
// NOT wired into any probe set or auto-run gate.

module pnrg_envelope_sweep

#precision(20mm)

// Subject: a circular profile swept along an interpolated (B-spline) path — a
// genuinely non-analytic swept surface, unlike a sweep along a line_segment
// (which is an exactly-representable ruled surface).
structure PnrgSweep {
    let g = sweep(circle(100mm), interp(0mm, 0mm, 0mm, 400mm, 600mm, 200mm, 900mm, 100mm, 700mm))
}

structure PnrgSweepCheck {
    param subject : PnrgSweep
    constraint RepresentationWithin(subject, 0.001mm)
}
