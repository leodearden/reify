// γ-verification ADVERSARY baseline fixture — indexed-sub-instantiation.md §7 γ,
// §6.2 row 4 "Queries see posed instances" (γ's PRD signal cites rows 1, 3, 4;
// the leaf-signal text silently dropped row 4). Premise the prover missed:
// TODAY, `distance(a.body, b.body)` between two posed hand-placed subs is NOT
// resolvable on the value-eval surface — `reify eval` exits 0 printing
// `Rig.a.body = undef`, `Rig.b.body = undef` and `Rig.d = undef`, and
// `reify check` exits 0 printing only "All constraints satisfied." with an
// empty stderr: nothing in this fixture constrains `d`, so the unresolved
// query is silent there (verified 2026-10-11 @ a030ee7528, release binary,
// OCCT build). Consequence for γ: row 4's observable cannot be an eval-print
// observable on today's substrate — it must ride the build/tessellate path or
// γ must extend eval-surface realization.
module posed_subs_distance_query_unresolvable

structure def P {
    param r : Length = 5mm
    let body = cylinder(r, 10mm)
}

structure def Rig {
    sub a = P() at transform3(orient_identity(), vec3(0mm, 0mm, 0mm))
    sub b = P() at transform3(orient_identity(), vec3(50mm, 0mm, 0mm))
    let d = distance(a.body, b.body)
}
