module dcr_solver_load_dropped_bare

// D3 decompose-phase CONTROL for PRD `docs/prds/v0_6/dimension-checked-readers.md`
// leaf γ1 (boundary row B1). Paired with `dcr_solver_load_dropped_dimensioned.ri`
// — the two files are IDENTICAL except for the spelling of the tip load.
//
// Geometry/material/support copied from `gui/test/fixtures/fea/cantilever_tip_load.ri`
// (1 m beam, 100 mm square section, Steel_AISI_1045, root clamp, tip load).
//
// This one spells the load the DIMENSIONLESS way, which `extract_loads`
// (crates/reify-eval/src/compute_targets/elastic_static.rs:4029,
//  `Some(Value::Real(f))`) is the ONLY spelling it accepts.
//
// MEASURED at decompose (2026-07-28, main efba5a8036):
//   result.max_von_mises = 5139325.408614099 kg*m^-1*s^-2,  iterations = 719
//
// γ1 must leave this number UNCHANGED while making the dimensioned twin match it.

structure DcrSolverLoadDroppedBare {
    param length : Length = 1000mm
    param width  : Length = 100mm
    param height : Length = 100mm

    let material = Steel_AISI_1045()
    let tip_load = PointLoad(point: "tip", force: 1000.0)
    let mount    = FixedSupport(target: "root")

    let result = solve_elastic_static(
        material, length, width, height, [tip_load], [mount], ElasticOptions()
    )
}
