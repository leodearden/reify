module dcr_solver_load_dropped_bare

// D3 decompose-phase CONTROL for PRD `docs/prds/v0_6/dimension-checked-readers.md`
// leaf γ1 (boundary row B1). Paired with `dcr_solver_load_dropped_dimensioned.ri`
// — the two files are IDENTICAL except for the spelling of the tip load.
//
// Geometry/material/support copied from `gui/test/fixtures/fea/cantilever_tip_load.ri`
// (1 m beam, 100 mm square section, Steel_AISI_1045, root clamp, tip load).
//
// This one spells the load the DIMENSIONLESS way, which `extract_loads`
// (crates/reify-eval/src/compute_targets/elastic_static.rs:4029,
//  `Some(Value::Real(f))`) is the ONLY spelling it accepts.
//
// MEASURED at decompose (2026-07-28, main efba5a8036):
//   result.max_von_mises = 5139325.408614099 kg*m^-1*s^-2,  iterations = 719
//
// POST-δ RE-MEASUREMENT (2026-09-25, main 12a9da343d; #5306 flipped
// CTOR_FIELD_CONFORMANCE_SEVERITY to Error):
//   `reify check` EXIT 0 / `reify eval` EXIT 0, UNCHANGED. No Error diagnostic,
//   and no ctor-conformance diagnostic of any severity.
//   result.max_von_mises = 5139325.408614099 Pa, iterations = 719, UNCHANGED.
//   δ cannot reach this file: PointLoad.force is still `Real` and receives a
//   bare Real. This control's predicted post-γ2 (#6941) state:
//   docs/notes/ctor-conformance-flip-leaf-signals.md.
//
// γ1 must leave this number UNCHANGED while making the dimensioned twin match it.
//
// POST-γ2 (2026-10-21, task #6941): MIGRATED, not retired, so this file's
// name is now historical. PointLoad.force is declared `Force`, so the bare
// `force: 1000.0` became a compile Error; this control now spells
// `force: 1000N` and is identical to its dimensioned twin. Retiring it instead
// would have edited scripts/verify.sh's _GUI_COUPLED_RI_FIXTURES (a
// verify-pipeline file) and the GUI grammar ledger.
//   `reify check` EXIT 0 / `reify eval` EXIT 0, no Error diagnostic. That the
//   bare spelling and the dimensioned one solve identically is pinned
//   in-process, against a control rather than a literal:
//   `gamma2_dimensioned_b1_fixture_solves_identically_to_its_bare_respelling`
//   (crates/reify-eval-fea-tests/tests/solve_elastic_static_e2e.rs).

structure DcrSolverLoadDroppedBare {
    param length : Length = 1000mm
    param width  : Length = 100mm
    param height : Length = 100mm

    let material = Steel_AISI_1045()
    let tip_load = PointLoad(point: "tip", force: 1000N)
    let mount    = FixedSupport(target: "root")

    let result = solve_elastic_static(
        material, length, width, height, [tip_load], [mount], ElasticOptions()
    )
}
