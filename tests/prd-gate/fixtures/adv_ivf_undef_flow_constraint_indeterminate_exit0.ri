module adv_ivf_undef_flow_constraint_indeterminate_exit0

pub structure Leaf {
    param k : Length = 10mm
    let body = translate(cylinder(2mm, k), 0mm, 0mm, 0mm - k / 2)
}

pub structure Top {
    sub a = Leaf(k: self.b.k) at transform3(orient_identity(), vec3(0mm, 0mm, 0mm))
    sub b = Leaf(k: 20mm)     at transform3(orient_identity(), vec3(100mm, 0mm, 0mm))
    let probe_k = self.a.k
    constraint probe_k > 0mm
}
