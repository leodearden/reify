module support_policy_modal_lone_pin

// support-realization-policy (docs/prds/v0_6/support-realization-policy.md) evidence fixture, leaf α.
// A lone PinnedSupport on a beam end is a hinge (ruling R3): the beam can swing about it, so the
// model has free rigid-body modes. Today modal silently realizes it as a full clamp (cantilever
// frequencies plus an I_ModalPinnedFaceRealization note). After α the modal solve reports the
// rigid-body modes through its existing channel instead (ruling R11: modal warns). The beam is
// short (20 x 10 x 10 mm: nx = 12, ny = 1, nz = 6, 182 nodes, 546 DOFs) so the solve stays below
// the 1024-DOF dense-fallback ceiling, where a singular K is reported as W_ModalRigidBodyMode.

structure SupportPolicyModalLonePin {
    let material = Steel_AISI_1045()
    let mi = FEAMaterialInput(material: material)
    let pin_root = PinnedSupport(target: "x_min")
    let opts = ModalOptions(
        n_modes: 3,
        boundary_conditions: [pin_root],
        damping: NoDamping(),
        reference_direction: vec3(0.0, 0.0, 1.0),
        element_order: ElementOrder.P1
    )
    let modes = modal_analysis(mi.material, 20mm, 10mm, 10mm, opts)
    let f1 = modes.modes[0].frequency
}
