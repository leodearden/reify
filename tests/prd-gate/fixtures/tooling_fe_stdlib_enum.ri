// /prd S27 tooling-front-end evidence: a clean stdlib-using module.
// `reify check` resolves the stdlib enum; the `reify mcp-server`
// get_diagnostics path (no-prelude `reify_compiler::compile`) reports
// "unresolved type: InfillPattern" on the same file.
module tooling_fe_stdlib_enum

structure def Print {
    param infill : InfillPattern = InfillPattern.Gyroid
    param w : Length = 10mm
}
