module realized_world_datum_plane_let

structure P {
    let b = box(10mm, 20mm, 30mm)
    let top = single(faces_by_normal(b, vec3(0.0, 0.0, 1.0), 1deg))
    let p : Plane = top.plane
    let r = mirror(b, p)
}
