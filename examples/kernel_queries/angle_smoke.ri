// Smoke fixture for angle(Direction, Direction) -> Angle (task 3614, KGQ-ε;
// Direction operands since direction-typing θ-b, task 9645)
// PRD: docs/prds/v0_3/kernel-geometry-queries.md §9
//
// User-observable signal:
//   angle(dir(1,0,0), dir(0,1,0)) == Angle(90 deg)  (exactly π/2 radians)
//
// Pure-math: acos(clamp(dot(a,b), -1, 1)) over two unit Directions. No kernel
// call. Args are let-bound dir values so they land in the engine values map
// as Value::Direction and are read by resolve_direction_arg.
//
// Pinning test:
//   crates/reify-eval/tests/harness_kernel_realization/kernel_queries_angle_smoke.rs::
//     angle_smoke_evals_to_ninety_degrees
//
// Grammar modelled on examples/topology_selectors/block_inertia.ri.

structure def AngleSmoke {
    let a = dir(1, 0, 0)
    let b = dir(0, 1, 0)
    let angle_ab = angle(a, b)
}
