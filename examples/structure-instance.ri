// SIR-α: Value::StructureInstance demonstration (task 3540).
//
// Running
//
//     reify eval examples/structure-instance.ri
//
// prints every top-level value cell. The structure constructors below
// evaluate to inspectable `Value::StructureInstance` values — a
// `TypeName { field: value, ... }` shape — rather than opaque `undef`,
// which is the SIR-α user-observable signal (PRD §7, design-decision-4).

// ── Flat construction ───────────────────────────────────────────────────────
//
// Concrete stdlib structures, every optional field defaulted. Each
// structure-valued `let` below evaluates to a flat `Value::StructureInstance`.
// A support's `target` is a required typed selector naming a face of `body`.
structure def FlatPart {
    let steel    = Steel_AISI_1045()
    let load     = PointLoad(point: vertex(body, "tip"))
    let pressure = PressureLoad()
    let support  = FixedSupport(target: face(body, "x_min"))
    let pinned   = PinnedSupport(target: face(body, "x_max"))
    let body     = box(1000mm, 100mm, 100mm)
}

// ── Nested compositional construction ───────────────────────────────────────
//
// `Beam`'s trait-typed params default to structure constructors, so a bare
// `Beam()` yields a `Value::StructureInstance` whose `material` and `load`
// fields are *themselves* nested `Value::StructureInstance` values
// (step-18's nested-default recursion). `load` defaults to `Gravity()`, a
// target-free Load: a `PointLoad` needs a typed `point` selector over
// geometry, which a param default cannot reach.
structure def Beam {
    param material : ElasticMaterial = Steel_AISI_1045()
    param load     : Load            = Gravity()
}

// Two `Beam` instances composed into one assembly. `primary` / `secondary`
// each evaluate to a nested-structure value carrying the Steel/Gravity
// sub-instances.
structure def NestedAssembly {
    let primary   = Beam()
    let secondary = Beam()
}
