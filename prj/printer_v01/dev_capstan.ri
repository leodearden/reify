module dev_capstan

// dev_capstan.ri — ISOLATED design sketch for the CoreXY drive capstan + fairlead.
//
// Standalone scratch file (NOT imported by printer.ri) for designing the two new
// drive components in isolation before integrating into DriveTendons/CoreXY.
// Self-contained: IdlerPulley is copied verbatim from printer.ri so this file
// renders on its own (single-file; no cross-file import in v0.1).
//
// DRIVE MODEL (agreed 2026-06-01): Vectran on a DUAL-ANCHOR WINCH CAPSTAN — both
// rope ends fixed to a helically-grooved drum (positive, zero-slip; NOT a friction
// wrap). Each belt's moment-balanced ±z pair = the TWO WINDINGS on one capstan, so
// there are 2 capstans (one per X/Y motor). As the drum turns it reels rope on one
// side / pays out the other; the active wrap band migrates axially, tracked by a
// PASSIVE TRANSLATING FAIRLEAD "shuttle" carrying 4 idlers that each take the first
// 90° corner on one of the 4 leads.
//
// FRAME: capstan axis = local +Z; leads leave tangentially in planes parallel to
// YZ (lower winding at the FRONT +X, upper at the BACK −X, so they never share an
// X-plane). The shuttle translates along Z to follow the band.
//
// BALANCE (design intent): on the shuttle the two idler-pairs turn in OPPOSITE
// senses (one pair "away", one "towards") so their couples about Y cancel → net
// force AND moment ≈ 0, enabling a near-rail-less float (a light rail is kept as
// insurance for the first-order-only rotational nulling + dynamics). The capstan's
// residual couple about X (from the two windings' axial separation under unequal
// tension) is reacted by its own shaft bearings — benign.
//
// MODELLING CAVEATS:
//  - Override drop (task 4147): the 4 shuttle idlers are identical IdlerPulley
//    DEFAULTS placed by pose only (`at` works), so 4147 never bites here. The
//    ShuttlePlate size is hand-matched to the idler corner spacing for the same
//    reason (can't pass sizes through the `sub`).
//  - DIN 15061 oversize seat arc (task 5683) is Capstan-only, NOT extended to
//    IdlerPulley: that seat is a RECTANGULAR flat-bottomed groove cut by a plain
//    cylinder — no seat ARC for a 0.53*d factor to apply to — and its round seat
//    stays deferred behind the unimplemented `torus` builtin (the dogfood gap
//    printer.ri records at its own IdlerPulley). This copy must stay verbatim:
//    printer.ri is out of 5683's scope, so re-seating here alone forks the two.

#version(0.1)

// ── Idler routing pulley (copied verbatim from printer.ri) ──────────────────
/// 608ZZ ball bearing (8mm bore, 22mm OD, 7mm wide) with a grooved sheave pressed
/// on its OD; modelled along local +Z (spin axis), centred. SEMICIRCULAR seat: a
/// torus (tube radius = groove_width/2) cut at the mid-plane with its tube centre
/// ON the rim surface — rope pitch circle at sheave_r (#4157 landed). One inlined
/// union/difference tree so only `body` surfaces.
pub structure IdlerPulley {
    param brg_od    : Length = 22mm
    param brg_bore  : Length = 8mm
    param brg_width : Length = 7mm
    param sheave_od    : Length = 36mm
    param groove_width : Length = 6mm
    param flange_width : Length = 2mm

    let brg_r       = brg_od / 2
    let sheave_r    = sheave_od / 2
    let groove_half = groove_width / 2
    let sheave_w    = groove_width + flange_width * 2
    let bore_len    = groove_width + flange_width * 3

    let body = union(
        difference(
            translate(cylinder(brg_r, brg_width), 0mm, 0mm, 0mm - brg_width / 2),
            translate(cylinder(brg_bore / 2, brg_width * 1.2), 0mm, 0mm, 0mm - brg_width * 0.6)
        ),
        difference(
            difference(
                translate(cylinder(sheave_r, sheave_w), 0mm, 0mm, 0mm - sheave_w / 2),
                torus(sheave_r, groove_half)
            ),
            translate(cylinder(brg_r, bore_len), 0mm, 0mm, 0mm - bore_len / 2)
        )
    )

    constraint sheave_od > brg_od
    constraint sheave_r - groove_half > brg_r
    constraint brg_od > brg_bore
}

// ── Capstan (dual-anchor winch drum) ────────────────────────────────────────
/// Helically-grooved winch drum, axis = local +Z, centred. Both belt ends anchor
/// to it; rotation reels one end in / pays the other out. Carries BOTH windings of
/// the belt's ±z moment pair (axially adjacent on the one drum).
///
/// The rope seat is modelled: a circular section of radius `groove_r` swept
/// along `helix(seat_c, lead, groove_len)` and subtracted from the land cylinder
/// at `land_r`, between two retaining flanges and over an axial shaft bore.
/// `blank_volume` − `body_volume` is the stock the seat removes.
///
/// The seat arc is DIN 15061 OVERSIZE: `groove_r = 0.53*rope_dia`, not the
/// `rope_dia/2` slip fit that would touch the rope everywhere at once. That buys
/// two things a winch drum needs — 6% of clearance at the mouth, and room at the
/// seat's widest section so a load-ovalised braid cannot pinch against the walls.
///
/// The land is placed at the seat's ARC CENTRE (`land_r = seat_c`), which does two
/// jobs. Mechanically it MAXIMISES the mouth chord
/// `2*sqrt(groove_r^2 - (land_r - seat_c)^2)` at `2*groove_r == 1.06*rope_dia` —
/// the best radial-lay clearance the arc can give. The rope is therefore laid in
/// RADIALLY, not wound in thread-style. That is what this drive needs:
/// `docs/projects/printer_v01.md` lists service as "Hours (re-wind capstans)", and
/// the departure tangent migrates axially across the band every revolution, so the
/// rope has to leave the seat radially at an arbitrary mid-band position.
/// Analytically it puts the land plane through the section's arc centre, so exactly
/// HALF the swept section stays seated — which is the premise the Rust acceptance
/// gate's volume closed form rests on, and why the in-file band below and that
/// gate's window are deliberately identical.
///
/// Note the land radius is now a DESIGN CHOICE and no longer forced. With an
/// oversize arc a whole band of land radii admits the rope,
/// `|land_r - seat_c| <= sqrt(groove_r^2 - (rope_dia/2)^2)` = 1.055mm wide at the
/// defaults; the pre-existing claim that a half-round is the ONLY depth that admits
/// the rope was true of the equal-radii seat and RETIRES here. The two reasons
/// above are what justify pinning it, not necessity.
///
/// It is the ROPE's centreline, not the arc centre, that stays on `pitch_r`: under
/// tension the rope bottoms out in its seat, so its centre sits `groove_r -
/// rope_dia/2` inboard of the arc centre, and the arc centre is put that far
/// OUTBOARD to compensate. So the D/d story below is untouched by the oversize arc.
/// The wrap stays positive and zero-slip because both rope ends are ANCHORED to
/// the drum, not because the channel traps them.
///
/// Sizing (D/d = 8 start): drum Ø = d_ratio·rope_dia = 48mm; pitch circ ≈ 151mm;
/// max per-belt feed = X+Y travel = 500+800 = 1.3m → ≈ 8.6 → 9 active turns;
/// band = active_turns·lead ≈ 63mm (= the shuttle stroke); helix angle ≈ 2.7°.
pub structure Capstan {
    param rope_dia    : Length = 6mm
    /// D/d ratio
    ///  Tendon-life lever. Larger ratio -> shallower bends -> longer life.
    ///    8 ≈ Vectran-friendly.
    ///  Sets mechanical advantage for drive. Larger -> Higher top speed, lower Acceleration.
    param d_ratio     : Real   = 8.0
    let drum_d : Length = rope_dia * d_ratio
    /// Helical pitch. CLEARANCE lead (> rope_dia) so adjacent wraps don't rub/wedge
    /// (wedging would drift the effective Ø → transmission-ratio error).
    param lead        : Length = 7mm
    /// Max per-belt rope feed = X-travel + Y-travel (documentation; drives turns).
    param feed        : Length = 1300mm
    /// Active wrap turns ≈ feed / (π·drum_Ø).
    let active_turns : Real  = feed / (pi * drum_d)
    /// Dead (anchored) turns total, both ends — keep tension off the anchors.
    param dead_total  : Real   = 4.0
    /// Windings per drum = the belt's ±z moment pair (documentation; one drum band).
    param windings    : Int    = 2
    param bore_dia    : Length = 19mm     // motor shaft

    /// Seat arc radius as a fraction of rope diameter. DIN 15061 rope-drum
    /// practice is r = 0.53·d: an OVERSIZE seat, so the rope has genuine
    /// clearance at the mouth and a load-ovalised braid cannot pinch at the
    /// seat bottom. 0.5 would be a zero-clearance slip fit.
    param seat_arc_ratio : Real = 0.53

    let pitch_r    = drum_d / 2                   // rope centreline (the D/d circle)
    let groove_r   = rope_dia * seat_arc_ratio    // rope seat = swept-cutter section radius
    // Seat arc CENTRE radius. Under tension the rope is pressed radially inward and
    // bottoms out in its seat, so its centre sits (groove_r - rope_dia/2) inboard of
    // the arc centre — put the arc centre that far OUTBOARD of pitch_r and the
    // seated rope's centreline lands exactly on the D/d circle. With an equal-radii
    // seat the two coincide, which is why this cell did not exist before.
    let seat_c     = pitch_r + groove_r - rope_dia / 2
    // Outer land/crest cylinder, cut back to the seat's ARC CENTRE. Its mouth is
    // then the seat's full width, 2*groove_r == 1.06*rope_dia — the widest the arc
    // can open — and exactly half the swept section stays seated. A shallower land
    // closes the mouth over the rope, a deeper one closes it back under (the mouth
    // chord peaks at land_r == seat_c).
    let land_r     = seat_c
    let flange_r   = pitch_r + rope_dia * 1.5     // stands proud of the rope crest
    let flange_w   = 6mm
    let groove_len : Length = lead * (active_turns + dead_total)   // axial wrap-band extent
    let bore_r     = bore_dia / 2

    // The rope channel: a circular section of radius groove_r, posed normal to the
    // helix start tangent (rotate -90° about +X takes the profile's +Z normal onto
    // +Y) and stood off onto the helix start point at +seat_c, swept along the
    // helical spine and re-centred on the band. The spine runs at the seat's ARC
    // CENTRE, which is where the section is centred — not at pitch_r, which is where
    // the seated rope's centreline ends up.
    aux let groove_profile = translate(rotate(circle(groove_r), 1.0, 0.0, 0.0, 0deg - 90deg), seat_c, 0mm, 0mm)
    aux let groove_path    = helix(seat_c, lead, groove_len)
    aux let groove_cutter  = translate(sweep(groove_profile, groove_path), 0mm, 0mm, 0mm - groove_len / 2)

    // Stock: land + two flanges, bored through — the drum before the groove is cut.
    aux let drum_blank = difference(
        union(
            union(
                translate(cylinder(land_r, groove_len), 0mm, 0mm, 0mm - groove_len / 2),
                translate(cylinder(flange_r, flange_w), 0mm, 0mm, groove_len / 2)
            ),
            translate(cylinder(flange_r, flange_w), 0mm, 0mm, 0mm - groove_len / 2 - flange_w)
        ),
        translate(cylinder(bore_r, groove_len + flange_w * 4), 0mm, 0mm, 0mm - groove_len / 2 - flange_w * 2)
    )

    let body = difference(drum_blank, groove_cutter)

    // Stock removed by cutting the groove (machining metric; also the acceptance
    // signal that the channel is really modelled — a smooth drum removes nothing).
    let blank_volume = volume(drum_blank)
    let body_volume  = volume(body)

    constraint flange_r > land_r
    // The seat arc must be OVERSIZE, never a slip fit. This ONE inequality is the
    // whole clearance story, stated in geometry rather than in a ratio: the seat's
    // half-width at the rope's WIDEST section is
    // sqrt(groove_r^2 - (groove_r - rope_dia/2)^2), which exceeds the rope's own
    // rope_dia/2 exactly when groove_r*rope_dia > rope_dia^2/2, i.e. exactly when
    // groove_r > rope_dia/2. So anti-pinch (a load-ovalised braid must not wedge
    // against the seat walls) and mouth clearance (2*groove_r > rope_dia) are the
    // same statement. A companion `seat_arc_ratio > 0.5` would be strictly implied
    // and is deliberately not written. No upper bound is needed either: the
    // clearance-lead constraint below already caps the arc at lead/2.
    constraint groove_r > rope_dia / 2
    // The land must sit ON the seat's ARC CENTRE — land_r == seat_c. The two bounds
    // below are the one-sided halves of that equality, written as the two distinct
    // ways a seat-depth edit breaks the drive:
    //  - a land above the arc centre leaves the seat submerged and closes the
    //    mouth back UNDER the rope; at land_r >= seat_c + groove_r there is no
    //    mouth at all — a buried tunnel, and the drum renders smooth. That
    //    break-through bound is subsumed by the tighter one here.
    //  - a land below the arc centre cuts the land past the section's centre, so
    //    the seated fraction drops below half and the mouth starts closing again.
    // Unlike the equal-radii seat this replaces, the pin is NOT forced by
    // admission: an oversize arc admits the rope anywhere within
    // sqrt(groove_r^2 - (rope_dia/2)^2) = 1.055mm of the arc centre. It is pinned
    // because the arc centre maximises the mouth AND because it is the only depth
    // that leaves exactly half the swept section seated — the premise the Rust
    // acceptance gate's volume closed form rests on.
    // The ±1e-6-of-groove_r width (3.18nm at the defaults) is fp slack around the
    // equality, not a design freedom: `land_r = seat_c` above is a bit-exact
    // assignment so the width only has to be positive. It is deliberately the SAME
    // window the Rust acceptance gate
    // (crates/reify-eval/tests/harness_sweep/capstan_groove_e2e.rs) uses to guard
    // that closed form, so there is no band of seat depths that passes
    // `reify check` here but panics there.
    constraint land_r < seat_c + groove_r * 0.000001
    constraint land_r > seat_c - groove_r * 0.000001
    // Wall between the groove BOTTOM (seat_c - groove_r = the deepest stock the
    // seat removes, which is the seated rope's own underside pitch_r - rope_dia/2
    // = 21mm) and the shaft bore. This is the ONLY wall statement: the weaker
    // `land_r > bore_r` it replaces bounded the land surface, which sits a full
    // groove_r clear of the seat's bottom, and is strictly implied by this one
    // given the band above (land_r == seat_c > bore_r + groove_r).
    constraint seat_c - groove_r > bore_r
    // Clearance lead: each wrap opens a 2*groove_r wide mouth in the land, so the
    // lead must exceed the MOUTH width or adjacent seats merge and the land ridge
    // between wraps vanishes (wedging would drift the effective Ø →
    // transmission-ratio error). With the DIN arc the mouth is 6.36mm and the
    // ridge narrows from 1.00mm to 0.64mm at the defaults — still positive, and no
    // longer numerically the same statement as `lead > rope_dia`.
    constraint lead > groove_r * 2.0
    constraint d_ratio > 0.0
}

// ── Fairlead shuttle ────────────────────────────────────────────────────────
/// The shuttle carrier plate (a leaf so it surfaces as one body). Hand-sized to
/// span the 4 idler corners (override drop — can't pass dims through the `sub`).
pub structure ShuttlePlate {
    param length : Length = 90mm
    param width : Length = 150mm
    param thickness : Length = 10mm
    let body = box(length, width, thickness)
    constraint length > 0mm
    constraint width > 0mm
    constraint thickness > 0mm
}

/// Passive translating fairlead: a plate + 4 routing idlers, one per capstan lead.
/// Idler spin axes = local +X (ropes turn in YZ planes); idlers at the 4 corners
/// (±X = front/back winding, ±Y = up/down lead). The shuttle slides along +Z
/// (plate normal = Z = capstan axis) to track the migrating band over `stroke`.
/// Front pair (+X) and back pair (−X) turn in OPPOSITE senses so the Y-couples
/// cancel (balanced float).
pub structure Fairlead {
    /// Front/back half-spacing of the idler stack (≈ pitch_r + clearance).
    param x_corner : Length = 30mm
    /// Up/down half-spacing of the lead turn points.
    param y_corner : Length = 50mm
    /// Band-migration travel range the shuttle covers (= Capstan active band).
    param stroke   : Length = 63mm

    let rot_to_x = orient_axis_angle(vec3(0mm, 1mm, 0mm), 90deg)  // idler +Z → +X (spin axis)
    let rot_to_y = orient_axis_angle(vec3(1mm, 0mm, 0mm), 90deg)  // idler +Z → +X (spin axis)
    let neg_x = 0mm - x_corner
    let neg_y = 0mm - y_corner
    // Idlers stand proud of the carrier on a bracket standoff (axle + bracket not
    // modelled). z_mount = plate_half + sheave_radius + gap so the wheels clear.
    let z_mount = 25mm

    sub plate    = ShuttlePlate() at transform3(rot_to_y, vec3(0mm, 0mm, 0mm))
    sub idler_fu = IdlerPulley()  at transform3(rot_to_x, vec3(x_corner, y_corner, z_mount))  // front-upper
    sub idler_fl = IdlerPulley()  at transform3(rot_to_x, vec3(x_corner, neg_y,   z_mount))  // front-lower
    sub idler_bu = IdlerPulley()  at transform3(rot_to_x, vec3(neg_x,    y_corner, z_mount))  // back-upper
    sub idler_bl = IdlerPulley()  at transform3(rot_to_x, vec3(neg_x,    neg_y,   z_mount))  // back-lower

    constraint x_corner > 0mm
    constraint y_corner > 0mm
    constraint stroke > 0mm
}

// ── Isolated assembly (capstan + shuttle, side by side for inspection) ───────
/// Top-level: the capstan at the origin (axis +Z) and the fairlead shuttle stood
/// off in +X so both are clearly visible. Relative pose is for inspection only —
/// real mating belongs to the DriveTendons integration step.
pub structure CapstanDrive {
    sub capstan = Capstan()  at transform3(orient_identity(), vec3(0mm,   0mm, 0mm))
    sub shuttle = Fairlead() at transform3(orient_identity(), vec3(150mm, 0mm, 0mm))
}
