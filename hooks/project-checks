#!/usr/bin/env bash
# reify project-specific checks (called from hooks/pre-commit, main branch only).
#
# Thin delegation to scripts/verify.sh — the single source of truth shared with
# dark-factory-orchestrator.yaml. --scope staged scopes the gate by `git diff --cached`.
# An empty stage gets an empty plan and exits 0. A docs-only stage does not: it is
# classified inert (no Rust or GUI phase), but any non-empty stage still gets the
# whole-tree infra gates of verify.sh's select_staged_whole_tree_gate plus any matching
# rows of scripts/verify-pipeline-infra-tests.txt, so a docs commit runs a small
# infra_selective-only plan (pinned by tests/infra/test_verify_scope.sh Scenario 1).
# --profile debug keeps the per-commit gate fast. Release coverage is the
# MERGE GATE's job (hooks/pre-merge-commit runs --profile both --scope all);
# per-task verify (dark-factory-orchestrator.yaml) and this per-commit gate both stay
# debug-only so the common, high-frequency path gives fast feedback.
# verify.sh bakes in the cargo env, sccache/jobserver, and OCCT LD_LIBRARY_PATH,
# so the hook no longer depends on the caller's ambient environment.
# verify.sh runs through the tree's canonical-build-path primitive, which execs it
# untouched in a real-path build directory.
#
# Receives repo root as $1.

ROOT="${1:?}"

exec "$ROOT/scripts/canon_run.py" exec -- "$ROOT/scripts/verify.sh" all --profile debug --scope staged --include-infra
